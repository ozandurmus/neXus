# SecurityExpert runtime / operational state (never repository content)
/output/
/logs/
/data/
/runtime/
/state/
/cas/
/.cas/
/support_bundles/

# RB.1 recovery-plane store (docs/design/BACKUP_RECOVERY_CONTRACTS.md §2) --
# lives on SECURITYEXPERT_RECOVERY_ROOT, physically separate from the repo,
# but ignore it here too in case a local/dev recovery root is ever pointed
# inside the checkout by mistake.
/recovery/
/vault/
*.enc

# Keep repository-safe placeholders/examples only when intentionally added
!/.gitkeep

# Local configuration / credentials / trust material
.env
.env.*
!.env.example
config.local.*
credentials.*
secrets.*
known_hosts
known_hosts.*
!known_hosts.example
*.key
*.pem
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# Generated reports / archives / local databases
support_bundle_*.zip
config_support_*.zip
Network_Inventory_Phase*.zip
storage_migration_*.json
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.journal
*.pcap
*.pcapng

# Python / test / coverage state
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Render-harness JS deps (dev/CI only; package.json + bun.lock are committed)
/tools/render-harness/node_modules/

# IDE / AI local state
.vscode/
.idea/
.cache/
.copilot/
.serena/

# OS / temporary / backup
.DS_Store
Thumbs.db
*.bak
*.tmp
*.swp
*~
.next-id

# Local-only real-env gate runner (may contain operational identities)
_realenv_gate_runner.py

# Local one-shot test / render output logs (never repository content)
pytest_result.log
pytest_*.log
pytest_failed.txt
render_only_*.log
