#!/usr/bin/env python3
"""Release entrypoint for the observer and its read-only MCP sibling."""

from pathlib import Path
import runpy
import sys


sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

if sys.argv[1:2] == ["mcp"]:
    del sys.argv[1]
    runpy.run_module("tools.delivery.workbench_companion_mcp", run_name="__main__")
else:
    from tools.delivery.workbench_companion import main

    raise SystemExit(main())
