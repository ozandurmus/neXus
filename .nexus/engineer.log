{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CerNT9Vz3tswjWcQjF9DK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01S98tqPPuATNJUgurcdPLtE","name":"Write","input":{"file_path":"/tmp/nexus_dashboard_ac8_demo/build_demo.py","content":"\"\"\"AC-8 acceptance-demonstration fixture builder -- disposable, mirrors the\nNXS-LOCAL-0012 scratch-demo precedent (isolated relay/state dirs, never the\nshared canonical relay or the shared orchestrator state dir, so this never\ntouches live governance state or other concurrent movements).\"\"\"\nimport json\nimport sys\nfrom pathlib import Path\n\nsys.path.insert(0, \"scripts\")\nimport local_relay as lr  # noqa: E402\nimport orchestrator as orch  # noqa: E402\n\nDEMO = Path(\"/tmp/nexus_dashboard_ac8_demo\")\nRELAY_DIR = DEMO / \"relay\"\nSTATE_DIR = DEMO / \"state\"\n\n\ndef start_report():\n    return {\n        \"baseline\": {\"origin_main\": \"deadbeef\"}, \"objective\": \"AC-8 acceptance demo movement.\",\n        \"scope\": {\"in\": [\"demo\"], \"out\": [\"not demo\"]}, \"movement_type\": \"VALIDATION\",\n        \"requirements\": [\"n/a\"], \"acceptance_criteria\": [\"n/a\"], \"validation_plan\": [\"n/a\"],\n        \"invariants\": [\"demo only, disposable\"], \"risks\": [], \"context_not_loaded\": [],\n        \"recommended_reasoning\": {\"tier\": \"Normal\", \"reason\": \"demo\"},\n        \"git\": {\"lane\": \"feature/demo\", \"base\": \"origin/main\"}, \"merge_gate\": \"n/a\",\n        \"deployment_direction\": \"local validation only\", \"output_contract\": [\"n/a\"],\n    }\n\n\ndef make_relay(movement_name: str) -> Path:\n    start = DEMO / f\"start_{movement_name}.json\"\n    start.write_text(json.dumps({\n        \"protocol_version\": 2, \"message_type\": \"SESSION_START\", \"movement\": movement_name,\n        \"refs\": [], \"report\": start_report(),\n    }), encoding=\"utf-8\")\n    rc = lr.main([\"create\", \"--role\", \"po\", \"--start\", str(start), \"--dir\", str(RELAY_DIR)])\n    assert rc == lr.EXIT_OK, f\"create failed for {movement_name}\"\n    return sorted(RELAY_DIR.glob(\"NXS-LOCAL-*.json\"))[-1]\n\n\ndef append(relay_file: Path, **kw):\n    argv = [\"append\", \"--file\", str(relay_file), \"--role\", kw[\"role\"], \"--marker\", kw[\"marker\"],\n            \"--subject\", kw[\"subject\"], \"--text\", kw[\"text\"], \"--next\", kw[\"next\"]]\n    rc = lr.main(argv)\n    assert rc == lr.EXIT_OK, f\"append failed: {kw}\"\n\n\ndef state_record(movement_id: str, *, pid: int, phase: str, branch: str, worktree_path: str) -> dict:\n    return {\n        \"movement_id\": movement_id, \"pid\": pid, \"phase\": phase, \"revision\": \"deadbeef\",\n        \"branch\": branch, \"worktree_path\": worktree_path, \"started_at\": lr._utc_now_iso(),\n        \"retry_count\": 0, \"dispatch_seq\": 1,\n    }\n\n\ndef main():\n    RELAY_DIR.mkdir(parents=True, exist_ok=True)\n    STATE_DIR.mkdir(parents=True, exist_ok=True)\n    repo_root = str(Path.cwd())\n\n    # DEMO_A: genuinely new PO decision pending.\n    relay_a = make_relay(\"DEMO_A_DECISION\")\n    movement_a = relay_a.stem.split(\"-\", 3)[0] + \"-\" + relay_a.stem.split(\"-\", 3)[1] + \"-\" + relay_a.stem.split(\"-\", 3)[2]\n    append(relay_a, role=\"engineer\", marker=\"RELAY_QUESTION\",\n           subject=\"[DECISION] Which retry backoff should stage 2 use?\",\n           text=\"Exponential (1/2/4s) or fixed 2s -- both satisfy the SLA; need a PO call.\", next=\"po\")\n    orch._save_state(STATE_DIR, movement_a, state_record(\n        movement_a, pid=1, phase=orch.PHASE_RUNNING, branch=\"feature/demo-a\", worktree_path=repo_root))\n\n    # DEMO_B: already-authorized action reached the wrong role (auto-route).\n    relay_b = make_relay(\"DEMO_B_AUTHORIZED\")\n    movement_b = relay_b.stem.split(\"-\", 3)[0] + \"-\" + relay_b.stem.split(\"-\", 3)[1] + \"-\" + relay_b.stem.split(\"-\", 3)[2]\n    append(relay_b, role=\"engineer\", marker=\"RELAY_QUESTION\",\n           subject=\"[AUTHORIZED] Run the already-approved regression suite\",\n           text=\"py -m pytest -q -n auto --dist worksteal -- already authorized by DEV.TEST.1, \"\n                \"just needs routing back to the engineer.\", next=\"po\")\n    orch._save_state(STATE_DIR, movement_b, state_record(\n        movement_b, pid=1, phase=orch.PHASE_RUNNING, branch=\"feature/demo-b\", worktree_path=repo_root))\n\n    # DEMO_C: actively running, engineer's turn -- used for the message-box demo.\n    relay_c = make_relay(\"DEMO_C_RUNNING\")\n    movement_c = relay_c.stem.split(\"-\", 3)[0] + \"-\" + relay_c.stem.split(\"-\", 3)[1] + \"-\" + relay_c.stem.split(\"-\", 3)[2]\n    orch._save_state(STATE_DIR, movement_c, state_record(\n        movement_c, pid=1, phase=orch.PHASE_RUNNING, branch=\"feature/demo-c\", worktree_path=repo_root))\n\n    print(json.dumps({\"movement_a\": movement_a, \"movement_b\": movement_b, \"movement_c\": movement_c}))\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1032,"cache_read_input_tokens":119696,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1032},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2940a6ba-1db4-4dd1-973a-c2b7cdc738e2","uuid":"3cf2adac-de81-4fb8-b58e-1e1e656a9880","timestamp":"2026-09-08T17:31:38.130Z","request_id":"req_011CerNT8g7vL2ZdiaaBBEg6"}
