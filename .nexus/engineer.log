{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CpHeiK9ks4jywUef3qwuJd","type":"tool_result","content":"440\tdef _load_state(state_dir: Path, movement_id: str) -> dict | None:\n441\t    path = _state_path(state_dir, movement_id)\n442\t    if not path.is_file():\n443\t        return None\n444\t    return json.loads(path.read_text(encoding=\"utf-8\"))\n445\t\n446\t\n447\tdef _save_state(state_dir: Path, movement_id: str, record: dict) -> None:\n448\t    lr._atomic_write(_state_path(state_dir, movement_id), lr._dump(record))\n449\t\n450\t\n451\tdef _list_state_records(state_dir: Path) -> list[dict]:\n452\t    if not state_dir.is_dir():\n453\t        return []\n454\t    records = []\n455\t    for path in sorted(state_dir.glob(\"NXS-LOCAL-*.json\")):\n456\t        try:\n457\t            records.append(json.loads(path.read_text(encoding=\"utf-8\")))\n458\t        except (OSError, json.JSONDecodeError):\n459\t            continue\n460\t    return records\n461\t\n462\t\n463\tdef _active_count(state_dir: Path, exclude_movement: str | None = None) -> int:\n464\t    count = 0\n465\t    for record in _list_state_records(state_dir):\n466\t        if record.get(\"movement_id\") == exclude_movement:\n467\t            continue\n468\t        if record.get(\"phase\") not in TERMINAL_PHASES and pid_alive(record.get(\"pid\")):\n469\t            count += 1\n470\t    return count\n471\t\n472\t\n473\t# ---------------------------------------------------------------------------\n474\t# Relay file resolution\n475\t# ---------------------------------------------------------------------------\n476\t\n477\tdef _resolve_relay_file(relay_dir: Path, movement_id: str) -> Path:\n478\t    matches = sorted(relay_dir.glob(f\"{movement_id}-*.json\"))\n479\t    if not matches:\n480\t        raise OrchestratorError(f\"no relay file found for {movement_id} under {relay_dir}\")\n481\t    if len(matches) > 1:\n482\t        raise OrchestratorError(f\"more than one relay file matches {movement_id} under {relay_dir}: {matches}\")\n483\t    return matches[0]\n484\t\n485\t\n486\tdef _load_relay(relay_file: Path) -> dict:\n487\t    obj = json.loads(relay_file.read_text(encoding=\"utf-8\"))\n488\t    errors = lr.validate_relay_object(obj)\n489\t    if errors:\n490\t        raise OrchestratorError(f\"{relay_file} fails validation: {'; '.join(errors)}\")\n491\t    return obj\n492\t\n493\t\n494\t# ---------------------------------------------------------------------------\n495\t# Git / subprocess side effects (argument lists only -- never shell text)\n496\t# ---------------------------------------------------------------------------\n497\t\n498\tdef _git_rev_parse(ref: str, cwd: Path) -> str:\n499\t    result = subprocess.run([\"git\", \"rev-parse\", ref], cwd=str(cwd), capture_output=True, text=True, timeout=30)\n500\t    if result.returncode != 0:\n501\t        raise OrchestratorError(f\"git rev-parse {ref} failed: {result.stderr.strip()}\")\n502\t    return result.stdout.strip()\n503\t\n504\t\n505\tdef _git_worktree_add(worktree_path: Path, base: str, branch: str, cwd: Path) -> None:\n506\t    result = subprocess.run(\n507\t        # <path> <commit-ish> -b <branch> -- matches the exact order\n508\t        # GOV_PO_1_GATE_5 already validated for the PO role's own\n509\t        # `git worktree add` calls (nexus_po_tool_gate.py, tests/test_gov_po_role.py).\n510\t        [\"git\", \"worktree\", \"add\", str(worktree_path), base, \"-b\", branch],\n511\t        cwd=str(cwd), capture_output=True, text=True, timeout=60,\n512\t    )\n513\t    if result.returncode != 0:\n514\t        raise OrchestratorError(f\"git worktree add failed: {result.stderr.strip()}\")"}]},"parent_tool_use_id":null,"session_id":"2940a6ba-1db4-4dd1-973a-c2b7cdc738e2","uuid":"063947e0-2133-4f24-9460-5ba586e26975","timestamp":"2026-09-08T17:30:49.073Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/OzanDur/Codo/neXus-nexus-worktrees/NXS-LOCAL-0021/scripts/orchestrator.py","content":"def _load_state(state_dir: Path, movement_id: str) -> dict | None:\n    path = _state_path(state_dir, movement_id)\n    if not path.is_file():\n        return None\n    return json.loads(path.read_text(encoding=\"utf-8\"))\n\n\ndef _save_state(state_dir: Path, movement_id: str, record: dict) -> None:\n    lr._atomic_write(_state_path(state_dir, movement_id), lr._dump(record))\n\n\ndef _list_state_records(state_dir: Path) -> list[dict]:\n    if not state_dir.is_dir():\n        return []\n    records = []\n    for path in sorted(state_dir.glob(\"NXS-LOCAL-*.json\")):\n        try:\n            records.append(json.loads(path.read_text(encoding=\"utf-8\")))\n        except (OSError, json.JSONDecodeError):\n            continue\n    return records\n\n\ndef _active_count(state_dir: Path, exclude_movement: str | None = None) -> int:\n    count = 0\n    for record in _list_state_records(state_dir):\n        if record.get(\"movement_id\") == exclude_movement:\n            continue\n        if record.get(\"phase\") not in TERMINAL_PHASES and pid_alive(record.get(\"pid\")):\n            count += 1\n    return count\n\n\n# ---------------------------------------------------------------------------\n# Relay file resolution\n# ---------------------------------------------------------------------------\n\ndef _resolve_relay_file(relay_dir: Path, movement_id: str) -> Path:\n    matches = sorted(relay_dir.glob(f\"{movement_id}-*.json\"))\n    if not matches:\n        raise OrchestratorError(f\"no relay file found for {movement_id} under {relay_dir}\")\n    if len(matches) > 1:\n        raise OrchestratorError(f\"more than one relay file matches {movement_id} under {relay_dir}: {matches}\")\n    return matches[0]\n\n\ndef _load_relay(relay_file: Path) -> dict:\n    obj = json.loads(relay_file.read_text(encoding=\"utf-8\"))\n    errors = lr.validate_relay_object(obj)\n    if errors:\n        raise OrchestratorError(f\"{relay_file} fails validation: {'; '.join(errors)}\")\n    return obj\n\n\n# ---------------------------------------------------------------------------\n# Git / subprocess side effects (argument lists only -- never shell text)\n# ---------------------------------------------------------------------------\n\ndef _git_rev_parse(ref: str, cwd: Path) -> str:\n    result = subprocess.run([\"git\", \"rev-parse\", ref], cwd=str(cwd), capture_output=True, text=True, timeout=30)\n    if result.returncode != 0:\n        raise OrchestratorError(f\"git rev-parse {ref} failed: {result.stderr.strip()}\")\n    return result.stdout.strip()\n\n\ndef _git_worktree_add(worktree_path: Path, base: str, branch: str, cwd: Path) -> None:\n    result = subprocess.run(\n        # <path> <commit-ish> -b <branch> -- matches the exact order\n        # GOV_PO_1_GATE_5 already validated for the PO role's own\n        # `git worktree add` calls (nexus_po_tool_gate.py, tests/test_gov_po_role.py).\n        [\"git\", \"worktree\", \"add\", str(worktree_path), base, \"-b\", branch],\n        cwd=str(cwd), capture_output=True, text=True, timeout=60,\n    )\n    if result.returncode != 0:\n        raise OrchestratorError(f\"git worktree add failed: {result.stderr.strip()}\")","numLines":75,"startLine":440,"totalLines":980}}}
