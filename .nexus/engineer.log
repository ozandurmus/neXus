{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012HagHVjdNTfDS8mtHkFE6m","type":"tool_result","content":"100\tSTAGE_MERGED = \"merged\"\n101\tSTAGE_UNKNOWN = \"unknown\"\n102\t\n103\t#: git porcelain v1 XY codes that mean \"an unresolved merge conflict is\n104\t#: present\" (unmerged paths) -- see `git status --porcelain` documentation.\n105\t_CONFLICT_CODES = frozenset({\"UU\", \"AA\", \"DD\", \"AU\", \"UA\", \"UD\", \"DU\"})\n106\t\n107\t#: Case-insensitive keywords in the most recent engineer.summary.log line\n108\t#: that indicate a test run is/was the last observed activity -- a real,\n109\t#: observed signal, never a guess about what is happening right now.\n110\t_TEST_ACTIVITY_KEYWORDS = (\"pytest\", \"test_\", \" tests\", \"-n auto\")\n111\t\n112\tBLOCKER_ALREADY_AUTHORIZED = \"already_authorized\"\n113\tBLOCKER_NEW_DECISION = \"new_decision\"\n114\tBLOCKER_PLATFORM_POLICY = \"platform_policy\"\n115\t_BLOCKER_TAGS = (\n116\t    (BLOCKER_ALREADY_AUTHORIZED, \"[AUTHORIZED]\"),\n117\t    (BLOCKER_PLATFORM_POLICY, \"[BLOCKED]\"),\n118\t    (BLOCKER_NEW_DECISION, \"[DECISION]\"),\n119\t)\n120\t\n121\tOPERATION_ROUTE_TO_ENGINEER = \"route_to_engineer\"\n122\tOPERATION_RECORD_DECISION = \"record_decision\"\n123\tOPERATION_REJECT = \"reject\"\n124\t\n125\t\n126\tclass DashboardError(Exception):\n127\t    \"\"\"A request could not be satisfied -- carries a human-readable reason.\"\"\"\n128\t\n129\t\n130\t# ---------------------------------------------------------------------------\n131\t# Pure helpers -- stage derivation, process status, blocker tagging\n132\t# (AC-7: unit-testable without a server, a git checkout, or gh)\n133\t# ---------------------------------------------------------------------------\n134\t\n135\tdef derive_process_status(row: dict) -> str:\n136\t    \"\"\"\"running\" / \"exited\" / \"disconnected\" -- distinct from work stage,\n137\t    sourced only from a live PID check (`orch.pid_alive`, already run by\n138\t    `_status_row`), never inferred from git or relay state.\"\"\"\n139\t    if row.get(\"pid_alive\"):\n140\t        return \"running\"\n141\t    if row.get(\"pid\"):\n142\t        return \"exited\"\n143\t    return \"disconnected\"\n144\t\n145\t\n146\tdef _looks_like_test_activity(last_activity: str | None) -> bool:\n147\t    if not last_activity:\n148\t        return False\n149\t    lowered = last_activity.lower()\n150\t    return any(keyword in lowered for keyword in _TEST_ACTIVITY_KEYWORDS)\n151\t\n152\t\n153\tdef derive_work_stage(\n154\t    *, relay_status: str | None, next_actor: str | None, phase: str | None,\n155\t    porcelain_lines: list[str], last_activity: str | None, has_open_pr: bool,\n156\t) -> str:\n157\t    \"\"\"Real per-movement stage (AC-3/invariants: never inferred from git\n158\t    dirtiness alone, never a fabricated percentage). Combines several real\n159\t    signals -- relay turn state, process phase, parsed worktree porcelain,\n160\t    the most recent engineer-posted activity line, and open-PR presence --\n161\t    in a fixed precedence order, exactly the combination the backlog note's\n162\t    own architecture section (C) and the AMENDMENT's stage list both call\n163\t    for. A worktree that no longer exists (porcelain_lines always empty for\n164\t    it) still resolves honestly via the other signals; nothing here raises.\"\"\"\n165\t    if relay_status == \"CLOSED\" or phase == orch.PHASE_DONE:\n166\t        return STAGE_MERGED\n167\t    if next_actor == \"po\":\n168\t        return STAGE_AWAITING_PO\n169\t    if any(line[:2] in _CONFLICT_CODES for line in porcelain_lines):\n170\t        return STAGE_RESOLVING_CONFLICT\n171\t    if has_open_pr:\n172\t        return STAGE_INTEGRATION\n173\t    if _looks_like_test_activity(last_activity):\n174\t        return STAGE_TESTING\n175\t    if porcelain_lines:\n176\t        return STAGE_CODING\n177\t    if relay_status == \"OPEN\":\n178\t        return STAGE_NOT_STARTED\n179\t    return STAGE_UNKNOWN\n180\t\n181\t\n182\tdef parse_blocker_tag(subject: str) -> tuple[str, str]:\n183\t    \"\"\"Split an optional leading bracket tag off a relay entry's own\n184\t    `subject` -- returns (blocker_source, subject_without_tag). An untagged\n185\t    subject defaults to `new_decision`, the safe choice: nothing is ever\n186\t    silently auto-routed without an explicit `[AUTHORIZED]` tag.\"\"\"\n187\t    subject = subject or \"\"\n188\t    for tag_name, prefix in _BLOCKER_TAGS:\n189\t        if subject.startswith(prefix):\n190\t            return tag_name, subject[len(prefix):].strip()\n191\t    return BLOCKER_NEW_DECISION, subject.strip()\n192\t\n193\t\n194\t# ---------------------------------------------------------------------------\n195\t# Config (GET/PUT /api/config) -- AC-7 targeted-test surface\n196\t# ---------------------------------------------------------------------------\n197\t\n198\tdef _config_path(repo_root: Path) -> Path:\n199\t    return repo_root / \".nexus\" / DEFAULT_CONFIG_FILENAME\n200\t\n201\t\n202\tdef read_config(repo_root: Path) -> dict:\n203\t    path = _config_path(repo_root)\n204\t    if not path.is_file():\n205\t        return {\"poll_interval_seconds\": orch.WATCH_INTERVAL_DEFAULT}\n206\t    try:\n207\t        obj = json.loads(path.read_text(encoding=\"utf-8\"))\n208\t    except (OSError, json.JSONDecodeError):\n209\t        return {\"poll_interval_seconds\": orch.WATCH_INTERVAL_DEFAULT}\n210\t    interval = obj.get(\"poll_interval_seconds\") if isinstance(obj, dict) else None\n211\t    if not isinstance(interval, int) or isinstance(interval, bool) or not (\n212\t        CONFIG_INTERVAL_MIN <= interval <= CONFIG_INTERVAL_MAX\n213\t    ):\n214\t        interval = orch.WATCH_INTERVAL_DEFAULT\n215\t    return {\"poll_interval_seconds\": interval}\n216\t\n217\t\n218\tdef write_config(repo_root: Path, poll_interval_seconds: Any) -> tuple[bool, dict | str]:\n219\t    if not isinstance(poll_interval_seconds, int) or isinstance(poll_interval_seconds, bool):\n220\t        return False, \"poll_interval_seconds must be an integer\"\n221\t    if not (CONFIG_INTERVAL_MIN <= poll_interval_seconds <= CONFIG_INTERVAL_MAX):\n222\t        return False, f\"poll_interval_seconds must be between {CONFIG_INTERVAL_MIN} and {CONFIG_INTERVAL_MAX}\"\n223\t    cfg = {\"poll_interval_seconds\": poll_interval_seconds}\n224\t    lr._atomic_write(_config_path(repo_root), json.dumps(cfg, sort_keys=True, indent=2) + \"\\n\")\n225\t    return True, cfg\n226\t\n227\t\n228\t# ---------------------------------------------------------------------------\n229\t# Action-id registry (AC-2a / AC-7)\n230\t# ---------------------------------------------------------------------------\n231\t\n232\tdef compute_action_id(\n233\t    *, movement_id: str, relay_file: str, operation: str, args: dict,\n234\t    working_directory: str, source_relay_seq: int,\n235\t) -> str:\n236\t    payload = {\n237\t        \"movement_id\": movement_id, \"relay_file\": relay_file, \"operation\": operation,\n238\t        \"args\": args, \"working_directory\": working_directory, \"source_relay_seq\": source_relay_seq,\n239\t    }\n240\t    return hashlib.sha256(orch.canonical_json(payload).encode(\"utf-8\")).hexdigest()[:16]\n241\t\n242\t\n243\tdef _actions_path(state_dir: Path, movement_id: str) -> Path:\n244\t    return state_dir / f\"{movement_id}.actions.json\"\n245\t\n246\t\n247\tdef load_actions(state_dir: Path, movement_id: str) -> dict:\n248\t    path = _actions_path(state_dir, movement_id)\n249\t    if not path.is_file():\n250\t        return {}\n251\t    try:\n252\t        obj = json.loads(path.read_text(encoding=\"utf-8\"))\n253\t    except (OSError, json.JSONDecodeError):\n254\t        return {}\n255\t    return obj if isinstance(obj, dict) else {}\n256\t\n257\t\n258\tdef save_actions(state_dir: Path, movement_id: str, registry: dict) -> None:\n259\t    lr._atomic_write(_actions_path(state_dir, movement_id), json.dumps(registry, sort_keys=True, indent=2) + \"\\n\")\n260\t\n261\t\n262\tdef register_action(\n263\t    state_dir: Path, movement_id: str, *, relay_file: str, operation: str, args: dict,\n264\t    working_directory: str, source_relay_seq: int,\n265\t) -> str:\n266\t    \"\"\"Idempotent: re-rendering the same card (same movement/operation/args/\n267\t    working_directory/source_relay_seq) always yields the same action_id and\n268\t    never clobbers an already-consumed record for that same id. A relay\n269\t    change (a new `source_relay_seq`) yields a different id -- the old one\n270\t    simply stays registered, unconsumed, and will fail the staleness check\n271\t    at the OLD id's own recorded `source_relay_seq` if anyone still holds it.\"\"\"\n272\t    action_id = compute_action_id(\n273\t        movement_id=movement_id, relay_file=relay_file, operation=operation, args=args,\n274\t        working_directory=working_directory, source_relay_seq=source_relay_seq,\n275\t    )\n276\t    registry = load_actions(state_dir, movement_id)\n277\t    if action_id not in registry:\n278\t        registry[action_id] = {\n279\t            \"operation\": operation, \"args\": args, \"working_directory\": working_directory,\n280\t            \"source_relay_seq\": source_relay_seq, \"issued_at\": lr._utc_now_iso(),\n281\t            \"consumed_at\": None, \"consumed_relay_seq\": None,\n282\t        }\n283\t        save_actions(state_dir, movement_id, registry)\n284\t    return action_id\n285\t\n286\t\n287\tdef check_action(state_dir: Path, movement_id: str, action_id: str, current_relay_seq: int) -> tuple[bool, dict | str]:\n288\t    \"\"\"Read-only staleness/duplicate-click check -- does not consume. Returns\n289\t    (ok, record) or (False, reason).\"\"\"\n290\t    registry = load_actions(state_dir, movement_id)\n291\t    record = registry.get(action_id)\n292\t    if record is None:\n293\t        return False, \"unknown action id\"\n294\t    if record.get(\"consumed_at\"):\n295\t        return False, \"action id already consumed\"\n296\t    if record.get(\"source_relay_seq\") != current_relay_seq:\n297\t        return False, \"stale action id -- the relay changed since this card was issued\"\n298\t    return True, record\n299\t\n300\t\n301\tdef mark_consumed(state_dir: Path, movement_id: str, action_id: str, consumed_relay_seq: int) -> None:\n302\t    registry = load_actions(state_dir, movement_id)\n303\t    if action_id in registry:\n304\t        registry[action_id][\"consumed_at\"] = lr._utc_now_iso()\n305\t        registry[action_id][\"consumed_relay_seq\"] = consumed_relay_seq\n306\t        save_actions(state_dir, movement_id, registry)\n307\t\n308\t\n309\t# ---------------------------------------------------------------------------\n310\t# Outbox (message box queued while it is not the PO's turn)\n311\t# ---------------------------------------------------------------------------\n312\t\n313\tdef _outbox_path(state_dir: Path, movement_id: str) -> Path:\n314\t    return state_dir / f\"{movement_id}.outbox.json\"\n315\t\n316\t\n317\tdef load_outbox(state_dir: Path, movement_id: str) -> list[dict]:\n318\t    path = _outbox_path(state_dir, movement_id)\n319\t    if not path.is_file():\n320\t        return []\n321\t    try:\n322\t        obj = json.loads(path.read_text(encoding=\"utf-8\"))\n323\t    except (OSError, json.JSONDecodeError):\n324\t        return []\n325\t    return obj if isinstance(obj, list) else []\n326\t\n327\t\n328\tdef queue_outbox_message(state_dir: Path, movement_id: str, text: str) -> None:\n329\t    items = load_outbox(state_dir, movement_id)\n330\t    items.append({\"text\": text, \"saved_at\": lr._utc_now_iso()})\n331\t    lr._atomic_write(_outbox_path(state_dir, movement_id), json.dumps(items, sort_keys=True, indent=2) + \"\\n\")\n332\t\n333\t\n334\t# ---------------------------------------------------------------------------\n335\t# Relay-write (reuses local_relay.py's own CLI path in-process, AC-6)\n336\t# ---------------------------------------------------------------------------\n337\t\n338\tdef append_to_relay(relay_file: Path, **kwargs: Any) -> dict:\n339\t    \"\"\"Builds the exact `local_relay append` argv the CLI itself accepts and\n340\t    dispatches through `local_relay.py`'s own parser/handler -- the same\n341\t    entry point an interactive session's `Bash` call would use -- rather\n342\t    than re-implementing any of its validation, locking, or turn-ownership\n343\t    logic. Raises DashboardError with the CLI's own stderr-equivalent\n344\t    message on any non-zero exit.\"\"\"\n345\t    argv = [\"append\", \"--file\", str(relay_file), \"--role\", kwargs[\"role\"], \"--marker\", kwargs[\"marker\"],\n346\t            \"--subject\", kwargs[\"subject\"], \"--text\", kwargs[\"text\"]]\n347\t    if kwargs[\"marker\"] == \"RELAY_DECISION\":\n348\t        argv += [\"--authorized-by\", kwargs[\"authorized_by\"], \"--scope\", kwargs[\"scope\"],\n349\t                  \"--supersedes\", kwargs[\"supersedes\"]]\n350\t    if kwargs.get(\"close\"):\n351\t        argv += [\"--close\"]\n352\t    else:\n353\t        argv += [\"--next\", kwargs[\"next_actor\"]]\n354\t\n355\t    parser = lr.build_parser()\n356\t    args = parser.parse_args(argv)\n357\t    out_buf, err_buf = io.StringIO(), io.StringIO()\n358\t    with contextlib.redirect_stdout(out_buf), contextlib.redirect_stderr(err_buf):\n359\t        rc = args.func(args)\n360\t    if rc != lr.EXIT_OK:\n361\t        raise DashboardError((err_buf.getvalue() or out_buf.getvalue()).strip() or f\"local_relay append failed (exit {rc})\")\n362\t    return json.loads(out_buf.getvalue())\n363\t\n364\t\n365\tdef execute_action(state_dir: Path, movement_id: str, relay_file: Path, action_id: str) -> dict:\n366\t    \"\"\"The ONE mechanism behind both \"automatic routing of an already-\n367\t    authorized action\" and a \"run this\" button (AC-4): resolve the\n368\t    registered action, verify it is still fresh, append it, mark it\n369\t    consumed. Every operation this registry can hold -- route_to_engineer,\n370\t    record_decision, reject -- ends here, identically.\"\"\"\n371\t    relay_obj = json.loads(relay_file.read_text(encoding=\"utf-8\"))\n372\t    current_seq = len(relay_obj.get(\"entries\") or [])\n373\t    ok, record_or_reason = check_action(state_dir, movement_id, action_id, current_seq)\n374\t    if not ok:\n375\t        raise DashboardError(str(record_or_reason))\n376\t    record = record_or_reason\n377\t    result = append_to_relay(relay_file, role=\"po\", **record[\"args\"])\n378\t    mark_consumed(state_dir, movement_id, action_id, result.get(\"seq\", current_seq + 1))\n379\t    return result\n380\t\n381\t\n382\tdef send_message(state_dir: Path, movement_id: str, relay_file: Path, text: str) -> dict:\n383\t    \"\"\"AC-5: message-delivery copy always defaults to the state actually\n384\t    achievable today. If it is the PO's turn right now, the note is\n385\t    appended immediately (still only \"saved -> queued for next resume\",\n386\t    never \"delivered\" -- appending is not the same as a running session\n387\t    reading it). If it is not the PO's turn (the frozen relay protocol's\n388\t    single-writer rule), the message is saved to a local outbox and the UI\n389\t    is told plainly that it is not yet appended.\"\"\"\n390\t    relay_obj = json.loads(relay_file.read_text(encoding=\"utf-8\"))\n391\t    if relay_obj.get(\"next_actor\") == \"po\" and relay_obj.get(\"status\") != \"CLOSED\":\n392\t        result = append_to_relay(\n393\t            relay_file, role=\"po\", marker=\"RELAY_NOTE\", subject=\"Message from Product Owner\",\n394\t            text=text, next_actor=\"engineer\",\n395\t        )\n396\t        return {\"delivery_state\": \"saved_queued_for_next_resume\", \"appended\": True, \"relay_result\": result}\n397\t    queue_outbox_message(state_dir, movement_id, text)\n398\t    return {\n399\t        \"delivery_state\": \"saved_not_yet_your_turn\", \"appended\": False,"}]},"parent_tool_use_id":null,"session_id":"2940a6ba-1db4-4dd1-973a-c2b7cdc738e2","uuid":"cf87319d-3fce-490d-bec9-ac7666884f2b","timestamp":"2026-09-08T17:24:15.149Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/OzanDur/Codo/neXus-nexus-worktrees/NXS-LOCAL-0021/scripts/orchestrator_dashboard.py","content":"STAGE_MERGED = \"merged\"\nSTAGE_UNKNOWN = \"unknown\"\n\n#: git porcelain v1 XY codes that mean \"an unresolved merge conflict is\n#: present\" (unmerged paths) -- see `git status --porcelain` documentation.\n_CONFLICT_CODES = frozenset({\"UU\", \"AA\", \"DD\", \"AU\", \"UA\", \"UD\", \"DU\"})\n\n#: Case-insensitive keywords in the most recent engineer.summary.log line\n#: that indicate a test run is/was the last observed activity -- a real,\n#: observed signal, never a guess about what is happening right now.\n_TEST_ACTIVITY_KEYWORDS = (\"pytest\", \"test_\", \" tests\", \"-n auto\")\n\nBLOCKER_ALREADY_AUTHORIZED = \"already_authorized\"\nBLOCKER_NEW_DECISION = \"new_decision\"\nBLOCKER_PLATFORM_POLICY = \"platform_policy\"\n_BLOCKER_TAGS = (\n    (BLOCKER_ALREADY_AUTHORIZED, \"[AUTHORIZED]\"),\n    (BLOCKER_PLATFORM_POLICY, \"[BLOCKED]\"),\n    (BLOCKER_NEW_DECISION, \"[DECISION]\"),\n)\n\nOPERATION_ROUTE_TO_ENGINEER = \"route_to_engineer\"\nOPERATION_RECORD_DECISION = \"record_decision\"\nOPERATION_REJECT = \"reject\"\n\n\nclass DashboardError(Exception):\n    \"\"\"A request could not be satisfied -- carries a human-readable reason.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Pure helpers -- stage derivation, process status, blocker tagging\n# (AC-7: unit-testable without a server, a git checkout, or gh)\n# ---------------------------------------------------------------------------\n\ndef derive_process_status(row: dict) -> str:\n    \"\"\"\"running\" / \"exited\" / \"disconnected\" -- distinct from work stage,\n    sourced only from a live PID check (`orch.pid_alive`, already run by\n    `_status_row`), never inferred from git or relay state.\"\"\"\n    if row.get(\"pid_alive\"):\n        return \"running\"\n    if row.get(\"pid\"):\n        return \"exited\"\n    return \"disconnected\"\n\n\ndef _looks_like_test_activity(last_activity: str | None) -> bool:\n    if not last_activity:\n        return False\n    lowered = last_activity.lower()\n    return any(keyword in lowered for keyword in _TEST_ACTIVITY_KEYWORDS)\n\n\ndef derive_work_stage(\n    *, relay_status: str | None, next_actor: str | None, phase: str | None,\n    porcelain_lines: list[str], last_activity: str | None, has_open_pr: bool,\n) -> str:\n    \"\"\"Real per-movement stage (AC-3/invariants: never inferred from git\n    dirtiness alone, never a fabricated percentage). Combines several real\n    signals -- relay turn state, process phase, parsed worktree porcelain,\n    the most recent engineer-posted activity line, and open-PR presence --\n    in a fixed precedence order, exactly the combination the backlog note's\n    own architecture section (C) and the AMENDMENT's stage list both call\n    for. A worktree that no longer exists (porcelain_lines always empty for\n    it) still resolves honestly via the other signals; nothing here raises.\"\"\"\n    if relay_status == \"CLOSED\" or phase == orch.PHASE_DONE:\n        return STAGE_MERGED\n    if next_actor == \"po\":\n        return STAGE_AWAITING_PO\n    if any(line[:2] in _CONFLICT_CODES for line in porcelain_lines):\n        return STAGE_RESOLVING_CONFLICT\n    if has_open_pr:\n        return STAGE_INTEGRATION\n    if _looks_like_test_activity(last_activity):\n        return STAGE_TESTING\n    if porcelain_lines:\n        return STAGE_CODING\n    if relay_status == \"OPEN\":\n        return STAGE_NOT_STARTED\n    return STAGE_UNKNOWN\n\n\ndef parse_blocker_tag(subject: str) -> tuple[str, str]:\n    \"\"\"Split an optional leading bracket tag off a relay entry's own\n    `subject` -- returns (blocker_source, subject_without_tag). An untagged\n    subject defaults to `new_decision`, the safe choice: nothing is ever\n    silently auto-routed without an explicit `[AUTHORIZED]` tag.\"\"\"\n    subject = subject or \"\"\n    for tag_name, prefix in _BLOCKER_TAGS:\n        if subject.startswith(prefix):\n            return tag_name, subject[len(prefix):].strip()\n    return BLOCKER_NEW_DECISION, subject.strip()\n\n\n# ---------------------------------------------------------------------------\n# Config (GET/PUT /api/config) -- AC-7 targeted-test surface\n# ---------------------------------------------------------------------------\n\ndef _config_path(repo_root: Path) -> Path:\n    return repo_root / \".nexus\" / DEFAULT_CONFIG_FILENAME\n\n\ndef read_config(repo_root: Path) -> dict:\n    path = _config_path(repo_root)\n    if not path.is_file():\n        return {\"poll_interval_seconds\": orch.WATCH_INTERVAL_DEFAULT}\n    try:\n        obj = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError):\n        return {\"poll_interval_seconds\": orch.WATCH_INTERVAL_DEFAULT}\n    interval = obj.get(\"poll_interval_seconds\") if isinstance(obj, dict) else None\n    if not isinstance(interval, int) or isinstance(interval, bool) or not (\n        CONFIG_INTERVAL_MIN <= interval <= CONFIG_INTERVAL_MAX\n    ):\n        interval = orch.WATCH_INTERVAL_DEFAULT\n    return {\"poll_interval_seconds\": interval}\n\n\ndef write_config(repo_root: Path, poll_interval_seconds: Any) -> tuple[bool, dict | str]:\n    if not isinstance(poll_interval_seconds, int) or isinstance(poll_interval_seconds, bool):\n        return False, \"poll_interval_seconds must be an integer\"\n    if not (CONFIG_INTERVAL_MIN <= poll_interval_seconds <= CONFIG_INTERVAL_MAX):\n        return False, f\"poll_interval_seconds must be between {CONFIG_INTERVAL_MIN} and {CONFIG_INTERVAL_MAX}\"\n    cfg = {\"poll_interval_seconds\": poll_interval_seconds}\n    lr._atomic_write(_config_path(repo_root), json.dumps(cfg, sort_keys=True, indent=2) + \"\\n\")\n    return True, cfg\n\n\n# ---------------------------------------------------------------------------\n# Action-id registry (AC-2a / AC-7)\n# ---------------------------------------------------------------------------\n\ndef compute_action_id(\n    *, movement_id: str, relay_file: str, operation: str, args: dict,\n    working_directory: str, source_relay_seq: int,\n) -> str:\n    payload = {\n        \"movement_id\": movement_id, \"relay_file\": relay_file, \"operation\": operation,\n        \"args\": args, \"working_directory\": working_directory, \"source_relay_seq\": source_relay_seq,\n    }\n    return hashlib.sha256(orch.canonical_json(payload).encode(\"utf-8\")).hexdigest()[:16]\n\n\ndef _actions_path(state_dir: Path, movement_id: str) -> Path:\n    return state_dir / f\"{movement_id}.actions.json\"\n\n\ndef load_actions(state_dir: Path, movement_id: str) -> dict:\n    path = _actions_path(state_dir, movement_id)\n    if not path.is_file():\n        return {}\n    try:\n        obj = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError):\n        return {}\n    return obj if isinstance(obj, dict) else {}\n\n\ndef save_actions(state_dir: Path, movement_id: str, registry: dict) -> None:\n    lr._atomic_write(_actions_path(state_dir, movement_id), json.dumps(registry, sort_keys=True, indent=2) + \"\\n\")\n\n\ndef register_action(\n    state_dir: Path, movement_id: str, *, relay_file: str, operation: str, args: dict,\n    working_directory: str, source_relay_seq: int,\n) -> str:\n    \"\"\"Idempotent: re-rendering the same card (same movement/operation/args/\n    working_directory/source_relay_seq) always yields the same action_id and\n    never clobbers an already-consumed record for that same id. A relay\n    change (a new `source_relay_seq`) yields a different id -- the old one\n    simply stays registered, unconsumed, and will fail the staleness check\n    at the OLD id's own recorded `source_relay_seq` if anyone still holds it.\"\"\"\n    action_id = compute_action_id(\n        movement_id=movement_id, relay_file=relay_file, operation=operation, args=args,\n        working_directory=working_directory, source_relay_seq=source_relay_seq,\n    )\n    registry = load_actions(state_dir, movement_id)\n    if action_id not in registry:\n        registry[action_id] = {\n            \"operation\": operation, \"args\": args, \"working_directory\": working_directory,\n            \"source_relay_seq\": source_relay_seq, \"issued_at\": lr._utc_now_iso(),\n            \"consumed_at\": None, \"consumed_relay_seq\": None,\n        }\n        save_actions(state_dir, movement_id, registry)\n    return action_id\n\n\ndef check_action(state_dir: Path, movement_id: str, action_id: str, current_relay_seq: int) -> tuple[bool, dict | str]:\n    \"\"\"Read-only staleness/duplicate-click check -- does not consume. Returns\n    (ok, record) or (False, reason).\"\"\"\n    registry = load_actions(state_dir, movement_id)\n    record = registry.get(action_id)\n    if record is None:\n        return False, \"unknown action id\"\n    if record.get(\"consumed_at\"):\n        return False, \"action id already consumed\"\n    if record.get(\"source_relay_seq\") != current_relay_seq:\n        return False, \"stale action id -- the relay changed since this card was issued\"\n    return True, record\n\n\ndef mark_consumed(state_dir: Path, movement_id: str, action_id: str, consumed_relay_seq: int) -> None:\n    registry = load_actions(state_dir, movement_id)\n    if action_id in registry:\n        registry[action_id][\"consumed_at\"] = lr._utc_now_iso()\n        registry[action_id][\"consumed_relay_seq\"] = consumed_relay_seq\n        save_actions(state_dir, movement_id, registry)\n\n\n# ---------------------------------------------------------------------------\n# Outbox (message box queued while it is not the PO's turn)\n# ---------------------------------------------------------------------------\n\ndef _outbox_path(state_dir: Path, movement_id: str) -> Path:\n    return state_dir / f\"{movement_id}.outbox.json\"\n\n\ndef load_outbox(state_dir: Path, movement_id: str) -> list[dict]:\n    path = _outbox_path(state_dir, movement_id)\n    if not path.is_file():\n        return []\n    try:\n        obj = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError):\n        return []\n    return obj if isinstance(obj, list) else []\n\n\ndef queue_outbox_message(state_dir: Path, movement_id: str, text: str) -> None:\n    items = load_outbox(state_dir, movement_id)\n    items.append({\"text\": text, \"saved_at\": lr._utc_now_iso()})\n    lr._atomic_write(_outbox_path(state_dir, movement_id), json.dumps(items, sort_keys=True, indent=2) + \"\\n\")\n\n\n# ---------------------------------------------------------------------------\n# Relay-write (reuses local_relay.py's own CLI path in-process, AC-6)\n# ---------------------------------------------------------------------------\n\ndef append_to_relay(relay_file: Path, **kwargs: Any) -> dict:\n    \"\"\"Builds the exact `local_relay append` argv the CLI itself accepts and\n    dispatches through `local_relay.py`'s own parser/handler -- the same\n    entry point an interactive session's `Bash` call would use -- rather\n    than re-implementing any of its validation, locking, or turn-ownership\n    logic. Raises DashboardError with the CLI's own stderr-equivalent\n    message on any non-zero exit.\"\"\"\n    argv = [\"append\", \"--file\", str(relay_file), \"--role\", kwargs[\"role\"], \"--marker\", kwargs[\"marker\"],\n            \"--subject\", kwargs[\"subject\"], \"--text\", kwargs[\"text\"]]\n    if kwargs[\"marker\"] == \"RELAY_DECISION\":\n        argv += [\"--authorized-by\", kwargs[\"authorized_by\"], \"--scope\", kwargs[\"scope\"],\n                  \"--supersedes\", kwargs[\"supersedes\"]]\n    if kwargs.get(\"close\"):\n        argv += [\"--close\"]\n    else:\n        argv += [\"--next\", kwargs[\"next_actor\"]]\n\n    parser = lr.build_parser()\n    args = parser.parse_args(argv)\n    out_buf, err_buf = io.StringIO(), io.StringIO()\n    with contextlib.redirect_stdout(out_buf), contextlib.redirect_stderr(err_buf):\n        rc = args.func(args)\n    if rc != lr.EXIT_OK:\n        raise DashboardError((err_buf.getvalue() or out_buf.getvalue()).strip() or f\"local_relay append failed (exit {rc})\")\n    return json.loads(out_buf.getvalue())\n\n\ndef execute_action(state_dir: Path, movement_id: str, relay_file: Path, action_id: str) -> dict:\n    \"\"\"The ONE mechanism behind both \"automatic routing of an already-\n    authorized action\" and a \"run this\" button (AC-4): resolve the\n    registered action, verify it is still fresh, append it, mark it\n    consumed. Every operation this registry can hold -- route_to_engineer,\n    record_decision, reject -- ends here, identically.\"\"\"\n    relay_obj = json.loads(relay_file.read_text(encoding=\"utf-8\"))\n    current_seq = len(relay_obj.get(\"entries\") or [])\n    ok, record_or_reason = check_action(state_dir, movement_id, action_id, current_seq)\n    if not ok:\n        raise DashboardError(str(record_or_reason))\n    record = record_or_reason\n    result = append_to_relay(relay_file, role=\"po\", **record[\"args\"])\n    mark_consumed(state_dir, movement_id, action_id, result.get(\"seq\", current_seq + 1))\n    return result\n\n\ndef send_message(state_dir: Path, movement_id: str, relay_file: Path, text: str) -> dict:\n    \"\"\"AC-5: message-delivery copy always defaults to the state actually\n    achievable today. If it is the PO's turn right now, the note is\n    appended immediately (still only \"saved -> queued for next resume\",\n    never \"delivered\" -- appending is not the same as a running session\n    reading it). If it is not the PO's turn (the frozen relay protocol's\n    single-writer rule), the message is saved to a local outbox and the UI\n    is told plainly that it is not yet appended.\"\"\"\n    relay_obj = json.loads(relay_file.read_text(encoding=\"utf-8\"))\n    if relay_obj.get(\"next_actor\") == \"po\" and relay_obj.get(\"status\") != \"CLOSED\":\n        result = append_to_relay(\n            relay_file, role=\"po\", marker=\"RELAY_NOTE\", subject=\"Message from Product Owner\",\n            text=text, next_actor=\"engineer\",\n        )\n        return {\"delivery_state\": \"saved_queued_for_next_resume\", \"appended\": True, \"relay_result\": result}\n    queue_outbox_message(state_dir, movement_id, text)\n    return {\n        \"delivery_state\": \"saved_not_yet_your_turn\", \"appended\": False,","numLines":300,"startLine":100,"totalLines":868}}}
