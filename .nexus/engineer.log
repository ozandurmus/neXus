{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RzcVGtgzA6w6qgr1zzXHv1","type":"tool_result","content":"400\t        \"note\": \"Not this movement's PO turn right now -- saved locally; \"\n401\t                \"post it again once the movement shows in \\\"Awaiting you\\\".\",\n402\t    }\n403\t\n404\t\n405\t# ---------------------------------------------------------------------------\n406\t# Read-only git/gh telemetry (side-effecting; degrade gracefully, never raise)\n407\t# ---------------------------------------------------------------------------\n408\t\n409\tdef git_worktree_porcelain(worktree_path: str | None) -> list[str]:\n410\t    if not worktree_path or not Path(worktree_path).is_dir():\n411\t        return []\n412\t    try:\n413\t        result = subprocess.run(\n414\t            [\"git\", \"status\", \"--porcelain\"], cwd=worktree_path,\n415\t            capture_output=True, text=True, timeout=15,\n416\t        )\n417\t    except (OSError, subprocess.TimeoutExpired):\n418\t        return []\n419\t    if result.returncode != 0:\n420\t        return []\n421\t    return [line for line in result.stdout.splitlines() if line.strip()]\n422\t\n423\t\n424\tdef git_ahead_behind(worktree_path: str | None, base: str = \"origin/main\") -> tuple[int | None, int | None]:\n425\t    if not worktree_path or not Path(worktree_path).is_dir():\n426\t        return None, None\n427\t    try:\n428\t        result = subprocess.run(\n429\t            [\"git\", \"rev-list\", \"--left-right\", \"--count\", f\"{base}...HEAD\"],\n430\t            cwd=worktree_path, capture_output=True, text=True, timeout=15,\n431\t        )\n432\t    except (OSError, subprocess.TimeoutExpired):\n433\t        return None, None\n434\t    if result.returncode != 0:\n435\t        return None, None\n436\t    parts = result.stdout.split()\n437\t    if len(parts) != 2:\n438\t        return None, None\n439\t    try:\n440\t        return int(parts[0]), int(parts[1])\n441\t    except ValueError:\n442\t        return None, None\n443\t\n444\t\n445\tdef gh_pr_info(branch: str | None, worktree_path: str | None) -> dict | None:\n446\t    if not branch or not worktree_path or shutil.which(\"gh\") is None:\n447\t        return None\n448\t    try:\n449\t        result = subprocess.run(\n450\t            [\"gh\", \"pr\", \"list\", \"--head\", branch, \"--json\", \"number,state,statusCheckRollup\", \"--limit\", \"1\"],\n451\t            cwd=worktree_path, capture_output=True, text=True, timeout=15,\n452\t        )\n453\t    except (OSError, subprocess.TimeoutExpired):\n454\t        return None\n455\t    if result.returncode != 0:\n456\t        return None\n457\t    try:\n458\t        data = json.loads(result.stdout)\n459\t    except json.JSONDecodeError:\n460\t        return None\n461\t    if not data:\n462\t        return None\n463\t    pr = data[0]\n464\t    checks = pr.get(\"statusCheckRollup\") or []\n465\t    conclusions = {c.get(\"conclusion\") for c in checks if isinstance(c, dict)}\n466\t    ci = \"unknown\"\n467\t    if conclusions:\n468\t        if \"FAILURE\" in conclusions or \"CANCELLED\" in conclusions:\n469\t            ci = \"red\"\n470\t        elif conclusions == {\"SUCCESS\"}:\n471\t            ci = \"green\"\n472\t        else:\n473\t            ci = \"running\"\n474\t    return {\"number\": pr.get(\"number\"), \"state\": pr.get(\"state\"), \"ci\": ci}\n475\t\n476\t\n477\tdef tail_log_lines(worktree_path: str | None, limit: int) -> list[str]:\n478\t    \"\"\"AC-3's Live-activity/Log surface: `engineer.summary.log`, falling\n479\t    back to raw `engineer.log` if the summary does not exist yet -- never an\n480\t    exception for a movement with no logs at all.\"\"\"\n481\t    if not worktree_path:\n482\t        return []\n483\t    nexus_dir = Path(worktree_path) / \".nexus\"\n484\t    for name in (\"engineer.summary.log\", \"engineer.log\"):\n485\t        path = nexus_dir / name\n486\t        if path.is_file():\n487\t            try:\n488\t                lines = path.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n489\t            except OSError:\n490\t                return []\n491\t            return lines[-limit:]\n492\t    return []\n493\t\n494\t\n495\t# ---------------------------------------------------------------------------\n496\t# Movement summary / detail assembly\n497\t# ---------------------------------------------------------------------------\n498\t\n499\tdef build_pending_action_card(\n500\t    *, movement_id: str, relay_file: Path, relay_obj: dict, worktree_path: str | None, state_dir: Path,\n501\t) -> dict | None:\n502\t    entries = relay_obj.get(\"entries\") or []\n503\t    if not entries or relay_obj.get(\"next_actor\") != \"po\" or relay_obj.get(\"status\") == \"CLOSED\":\n504\t        return None\n505\t    last = entries[-1]\n506\t    if not isinstance(last, dict) or last.get(\"marker\") not in (\"RELAY_QUESTION\", \"RELAY_NOTE\"):\n507\t        return None\n508\t    blocker_source, clean_subject = parse_blocker_tag(last.get(\"subject\") or \"\")\n509\t    text = last.get(\"text\") or \"\"\n510\t    source_relay_seq = len(entries)\n511\t    working_directory = worktree_path or \"\"\n512\t\n513\t    if blocker_source == BLOCKER_PLATFORM_POLICY:\n514\t        return {\n515\t            \"blocker_source\": blocker_source, \"requested_action\": clean_subject, \"detail\": text,\n516\t            \"primary_action_id\": None, \"primary_operation\": None, \"reject_action_id\": None,\n517\t        }\n518\t\n519\t    if blocker_source == BLOCKER_ALREADY_AUTHORIZED:\n520\t        operation = OPERATION_ROUTE_TO_ENGINEER\n521\t        primary_args = {\n522\t            \"marker\": \"RELAY_NOTE\", \"subject\": f\"Routed: {clean_subject}\",\n523\t            \"text\": f\"Automatically routed to engineer -- already authorized. Original request: {text}\",\n524\t            \"next_actor\": \"engineer\",\n525\t        }\n526\t    else:\n527\t        operation = OPERATION_RECORD_DECISION\n528\t        primary_args = {\n529\t            \"marker\": \"RELAY_DECISION\", \"subject\": clean_subject, \"text\": text, \"next_actor\": \"engineer\",\n530\t            \"authorized_by\": \"Product Owner -- dashboard action\", \"scope\": f\"{movement_id} dashboard action\",\n531\t            \"supersedes\": \"none\",\n532\t        }\n533\t\n534\t    primary_id = register_action(\n535\t        state_dir, movement_id, relay_file=str(relay_file), operation=operation, args=primary_args,\n536\t        working_directory=working_directory, source_relay_seq=source_relay_seq,\n537\t    )\n538\t\n539\t    reject_args = {\n540\t        \"marker\": \"RELAY_DECISION\", \"subject\": f\"Declined: {clean_subject}\", \"text\": text, \"next_actor\": \"engineer\",\n541\t        \"authorized_by\": \"Product Owner -- dashboard action\", \"scope\": f\"{movement_id} dashboard action\",\n542\t        \"supersedes\": \"none\",\n543\t    }\n544\t    reject_id = register_action(\n545\t        state_dir, movement_id, relay_file=str(relay_file), operation=OPERATION_REJECT, args=reject_args,\n546\t        working_directory=working_directory, source_relay_seq=source_relay_seq,\n547\t    )\n548\t\n549\t    return {\n550\t        \"blocker_source\": blocker_source, \"requested_action\": clean_subject, \"detail\": text,\n551\t        \"primary_action_id\": primary_id, \"primary_operation\": operation, \"reject_action_id\": reject_id,\n552\t    }\n553\t\n554\t\n555\tdef build_movement_summary(record: dict, relay_dir: Path, state_dir: Path, retry_limit: int) -> dict:\n556\t    row = orch._status_row(record, relay_dir, retry_limit)\n557\t    worktree_path = row.get(\"worktree_path\")\n558\t    porcelain = git_worktree_porcelain(worktree_path)\n559\t    pr_info = gh_pr_info(row.get(\"branch\"), worktree_path)\n560\t\n561\t    relay_status, next_actor, pending_action = row.get(\"relay_status\"), None, None\n562\t    try:\n563\t        relay_file = orch._resolve_relay_file(relay_dir, row[\"movement_id\"])\n564\t        relay_obj = orch._load_relay(relay_file)\n565\t        next_actor = relay_obj.get(\"next_actor\")\n566\t        pending_action = build_pending_action_card(\n567\t            movement_id=row[\"movement_id\"], relay_file=relay_file, relay_obj=relay_obj,\n568\t            worktree_path=worktree_path, state_dir=state_dir,\n569\t        )\n570\t    except orch.OrchestratorError:\n571\t        pass\n572\t\n573\t    stage = derive_work_stage(\n574\t        relay_status=relay_status, next_actor=next_actor, phase=row.get(\"phase\"),\n575\t        porcelain_lines=porcelain, last_activity=row.get(\"last_activity\"), has_open_pr=bool(pr_info),\n576\t    )\n577\t    return {\n578\t        **row,\n579\t        \"process_status\": derive_process_status(row),\n580\t        \"work_stage\": stage,\n581\t        \"next_actor\": next_actor,\n582\t        \"open_pr\": pr_info,\n583\t        \"pending_action\": pending_action,\n584\t        \"outbox_pending\": len(load_outbox(state_dir, row[\"movement_id\"])),\n585\t    }\n586\t\n587\t\n588\tdef gather_movements(state_dir: Path, relay_dir: Path, retry_limit: int) -> dict:\n589\t    summaries = [\n590\t        build_movement_summary(record, relay_dir, state_dir, retry_limit)\n591\t        for record in orch._list_state_records(state_dir)\n592\t    ]\n593\t    summaries.sort(key=lambda s: s[\"movement_id\"])\n594\t    running = [s for s in summaries if s[\"work_stage\"] not in (STAGE_MERGED,) and s[\"process_status\"] != \"disconnected\"]\n595\t    awaiting = [s for s in summaries if s[\"pending_action\"] is not None]\n596\t    recent = [s for s in summaries if s[\"work_stage\"] == STAGE_MERGED]\n597\t    integration = [s for s in summaries if s[\"work_stage\"] == STAGE_INTEGRATION]\n598\t    return {\n599\t        \"summary\": {\n600\t            \"running\": len(running), \"awaiting_decision\": len(awaiting), \"in_integration\": len(integration),\n601\t        },\n602\t        \"movements\": summaries,\n603\t    }\n604\t\n605\t\n606\tdef build_movement_detail(movement_id: str, relay_dir: Path, state_dir: Path, retry_limit: int) -> dict:\n607\t    record = orch._load_state(state_dir, movement_id)\n608\t    if record is None:\n609\t        raise DashboardError(f\"no state record for {movement_id}\")\n610\t    summary = build_movement_summary(record, relay_dir, state_dir, retry_limit)\n611\t\n612\t    relay_file = orch._resolve_relay_file(relay_dir, movement_id)\n613\t    relay_obj = orch._load_relay(relay_file)\n614\t    behind, ahead = git_ahead_behind(record.get(\"worktree_path\"))\n615\t\n616\t    approved_task = None\n617\t    worktree_path = record.get(\"worktree_path\")\n618\t    if worktree_path:\n619\t        task_path = Path(worktree_path) / \".nexus\" / \"approved_task.json\"\n620\t        if task_path.is_file():\n621\t            try:\n622\t                approved_task = json.loads(task_path.read_text(encoding=\"utf-8\"))\n623\t            except (OSError, json.JSONDecodeError):\n624\t                approved_task = None\n625\t\n626\t    return {\n627\t        **summary,\n628\t        \"relay_entries\": relay_obj.get(\"entries\", []),\n629\t        \"relay_id\": relay_obj.get(\"id\"),\n630\t        \"ahead\": ahead, \"behind\": behind,\n631\t        \"approved_task\": approved_task,\n632\t        \"outbox\": load_outbox(state_dir, movement_id),\n633\t    }\n634\t\n635\t\n636\t# ---------------------------------------------------------------------------\n637\t# HTTP layer\n638\t# ---------------------------------------------------------------------------\n639\t\n640\tdef _json_bytes(obj: Any) -> bytes:\n641\t    return (json.dumps(obj, sort_keys=True) + \"\\n\").encode(\"utf-8\")\n642\t\n643\t\n644\tdef make_handler_class(*, token: str, relay_dir: Path, state_dir: Path, repo_root: Path,\n645\t                        retry_limit: int, port: int) -> type[BaseHTTPRequestHandler]:\n646\t    expected_origin = f\"http://127.0.0.1:{port}\"\n647\t\n648\t    class Handler(BaseHTTPRequestHandler):\n649\t        server_version = \"neXusDashboard/1\"\n650\t\n651\t        def log_message(self, fmt: str, *args: Any) -> None:  # quiet by default\n652\t            pass\n653\t\n654\t        # -- auth -------------------------------------------------------\n655\t        def _authorized(self) -> bool:\n656\t            header = self.headers.get(\"Authorization\", \"\")\n657\t            if not header.startswith(\"Bearer \"):\n658\t                return False\n659\t            return hmac.compare_digest(header[len(\"Bearer \"):], token)\n660\t\n661\t        def _origin_ok(self) -> bool:\n662\t            origin = self.headers.get(\"Origin\")\n663\t            return origin is None or origin == expected_origin\n664\t\n665\t        def _send_json(self, status: int, obj: Any) -> None:\n666\t            body = _json_bytes(obj)\n667\t            self.send_response(status)\n668\t            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n669\t            self.send_header(\"Content-Length\", str(len(body)))\n670\t            self.end_headers()\n671\t            self.wfile.write(body)\n672\t\n673\t        def _send_static(self, path: Path, content_type: str) -> None:\n674\t            if not path.is_file():\n675\t                self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n676\t                return\n677\t            body = path.read_bytes()\n678\t            self.send_response(HTTPStatus.OK)\n679\t            self.send_header(\"Content-Type\", content_type)\n680\t            self.send_header(\"Content-Length\", str(len(body)))\n681\t            self.end_headers()\n682\t            self.wfile.write(body)\n683\t\n684\t        def _read_json_body(self) -> Any:\n685\t            length = int(self.headers.get(\"Content-Length\", 0) or 0)\n686\t            if length <= 0:\n687\t                return {}\n688\t            raw = self.rfile.read(length)\n689\t            try:\n690\t                return json.loads(raw.decode(\"utf-8\"))\n691\t            except (UnicodeDecodeError, json.JSONDecodeError):\n692\t                return None\n693\t\n694\t        # -- routing ------------------------------------------------------\n695\t        def do_GET(self) -> None:  # noqa: N802 -- BaseHTTPRequestHandler naming\n696\t            parts = urlsplit(self.path)\n697\t            path, query = parts.path, parse_qs(parts.query)\n698\t\n699\t            if path == \"/\":\n700\t                self._send_static(ASSETS_DIR / \"index.html\", \"text/html; charset=utf-8\")\n701\t                return\n702\t            if path == \"/dashboard.css\":\n703\t                self._send_static(ASSETS_DIR / \"dashboard.css\", \"text/css; charset=utf-8\")\n704\t                return\n705\t            if path == \"/dashboard.js\":\n706\t                self._send_static(ASSETS_DIR / \"dashboard.js\", \"application/javascript; charset=utf-8\")\n707\t                return\n708\t\n709\t            if not path.startswith(\"/api/\"):\n710\t                self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n711\t                return\n712\t            if not self._authorized():\n713\t                self._send_json(HTTPStatus.UNAUTHORIZED, {\"error\": \"missing or invalid bearer token\"})\n714\t                return\n715\t\n716\t            if path == \"/api/movements\":\n717\t                self._send_json(HTTPStatus.OK, gather_movements(state_dir, relay_dir, retry_limit))\n718\t                return\n719\t            if path == \"/api/config\":\n720\t                self._send_json(HTTPStatus.OK, read_config(repo_root))\n721\t                return\n722\t            if path.startswith(\"/api/movements/\"):\n723\t                rest = path[len(\"/api/movements/\"):]\n724\t                if rest.endswith(\"/log\"):\n725\t                    movement_id = rest[: -len(\"/log\")]\n726\t                    limit = LOG_TAIL_DEFAULT\n727\t                    if \"tail\" in query:\n728\t                        try:\n729\t                            limit = max(1, min(LOG_TAIL_MAX, int(query[\"tail\"][0])))\n730\t                        except ValueError:\n731\t                            pass\n732\t                    record = orch._load_state(state_dir, movement_id)\n733\t                    if record is None:\n734\t                        self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"unknown movement\"})\n735\t                        return\n736\t                    self._send_json(HTTPStatus.OK, {\"lines\": tail_log_lines(record.get(\"worktree_path\"), limit)})\n737\t                    return\n738\t                movement_id = rest\n739\t                try:\n740\t                    detail = build_movement_detail(movement_id, relay_dir, state_dir, retry_limit)\n741\t                except (DashboardError, orch.OrchestratorError) as exc:\n742\t                    self._send_json(HTTPStatus.NOT_FOUND, {\"error\": str(exc)})\n743\t                    return\n744\t                self._send_json(HTTPStatus.OK, detail)\n745\t                return\n746\t\n747\t            self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n748\t\n749\t        def do_PUT(self) -> None:  # noqa: N802\n750\t            if not self.path.startswith(\"/api/\"):\n751\t                self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n752\t                return\n753\t            if not self._authorized():\n754\t                self._send_json(HTTPStatus.UNAUTHORIZED, {\"error\": \"missing or invalid bearer token\"})\n755\t                return\n756\t            if not self._origin_ok():\n757\t                self._send_json(HTTPStatus.FORBIDDEN, {\"error\": \"origin not allowed\"})\n758\t                return\n759\t            if self.path == \"/api/config\":\n760\t                body = self._read_json_body()\n761\t                if not isinstance(body, dict):\n762\t                    self._send_json(HTTPStatus.BAD_REQUEST, {\"error\": \"invalid JSON body\"})\n763\t                    return\n764\t                ok, result = write_config(repo_root, body.get(\"poll_interval_seconds\"))\n765\t                self._send_json(HTTPStatus.OK if ok else HTTPStatus.BAD_REQUEST,\n766\t                                 result if ok else {\"error\": result})\n767\t                return\n768\t            self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n769\t\n770\t        def do_POST(self) -> None:  # noqa: N802\n771\t            if not self.path.startswith(\"/api/movements/\"):\n772\t                self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n773\t                return\n774\t            if not self._authorized():\n775\t                self._send_json(HTTPStatus.UNAUTHORIZED, {\"error\": \"missing or invalid bearer token\"})\n776\t                return\n777\t            if not self._origin_ok():\n778\t                self._send_json(HTTPStatus.FORBIDDEN, {\"error\": \"origin not allowed\"})\n779\t                return\n780\t\n781\t            rest = self.path[len(\"/api/movements/\"):]\n782\t            body = self._read_json_body()\n783\t            if body is None:\n784\t                self._send_json(HTTPStatus.BAD_REQUEST, {\"error\": \"invalid JSON body\"})\n785\t                return\n786\t\n787\t            if \"/actions/\" in rest and rest.endswith(\"/execute\"):\n788\t                movement_id, remainder = rest.split(\"/actions/\", 1)\n789\t                action_id = remainder[: -len(\"/execute\")]\n790\t                try:\n791\t                    relay_file = orch._resolve_relay_file(relay_dir, movement_id)\n792\t                except orch.OrchestratorError as exc:\n793\t                    self._send_json(HTTPStatus.NOT_FOUND, {\"error\": str(exc)})\n794\t                    return\n795\t                try:\n796\t                    result = execute_action(state_dir, movement_id, relay_file, action_id)\n797\t                except DashboardError as exc:\n798\t                    self._send_json(HTTPStatus.CONFLICT, {\"error\": str(exc)})\n799\t                    return\n800\t                self._send_json(HTTPStatus.OK, result)\n801\t                return\n802\t\n803\t            if rest.endswith(\"/message\"):\n804\t                movement_id = rest[: -len(\"/message\")]\n805\t                text = (body or {}).get(\"text\") if isinstance(body, dict) else None\n806\t                if not text or not isinstance(text, str):\n807\t                    self._send_json(HTTPStatus.BAD_REQUEST, {\"error\": \"text is required\"})\n808\t                    return\n809\t                try:\n810\t                    relay_file = orch._resolve_relay_file(relay_dir, movement_id)\n811\t                except orch.OrchestratorError as exc:\n812\t                    self._send_json(HTTPStatus.NOT_FOUND, {\"error\": str(exc)})\n813\t                    return\n814\t                try:\n815\t                    result = send_message(state_dir, movement_id, relay_file, text)\n816\t                except DashboardError as exc:\n817\t                    self._send_json(HTTPStatus.CONFLICT, {\"error\": str(exc)})\n818\t                    return\n819\t                self._send_json(HTTPStatus.OK, result)\n820\t                return\n821\t\n822\t            self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n823\t\n824\t    return Handler\n825\t\n826\t\n827\t# ---------------------------------------------------------------------------\n828\t# CLI\n829\t# ---------------------------------------------------------------------------\n830\t\n831\tdef run_dashboard(*, port: int, relay_dir: Path, state_dir: Path, repo_root: Path, retry_limit: int) -> None:\n832\t    token = secrets.token_urlsafe(32)\n833\t    handler_cls = make_handler_class(\n834\t        token=token, relay_dir=relay_dir, state_dir=state_dir, repo_root=repo_root,\n835\t        retry_limit=retry_limit, port=port,\n836\t    )\n837\t    httpd = ThreadingHTTPServer((\"127.0.0.1\", port), handler_cls)\n838\t    print(f\"neXus dashboard listening -- open http://127.0.0.1:{port}/#t={token}\")\n839\t    try:\n840\t        httpd.serve_forever()\n841\t    except KeyboardInterrupt:\n842\t        pass\n843\t    finally:\n844\t        httpd.server_close()\n845\t\n846\t\n847\tdef build_parser() -> argparse.ArgumentParser:\n848\t    parser = argparse.ArgumentParser(prog=\"orchestrator_dashboard\", description=__doc__)\n849\t    parser.add_argument(\"--port\", type=int, default=DEFAULT_PORT)\n850\t    parser.add_argument(\"--relay-dir\", default=\"relay\")\n851\t    parser.add_argument(\"--state-dir\", default=str(orch.DEFAULT_STATE_DIR))\n852\t    parser.add_argument(\"--repo-root\", default=str(REPO_ROOT))\n853\t    parser.add_argument(\"--retry-limit\", type=int, default=orch.DEFAULT_RETRY_LIMIT)\n854\t    return parser\n855\t\n856\t\n857\tdef main(argv: list[str] | None = None) -> int:\n858\t    args = build_parser().parse_args(argv)\n859\t    run_dashboard(\n860\t        port=args.port, relay_dir=Path(args.relay_dir).resolve(), state_dir=Path(args.state_dir),\n861\t        repo_root=Path(args.repo_root).resolve(), retry_limit=args.retry_limit,\n862\t    )\n863\t    return 0\n864\t\n865\t\n866\tif __name__ == \"__main__\":"}]},"parent_tool_use_id":null,"session_id":"2940a6ba-1db4-4dd1-973a-c2b7cdc738e2","uuid":"9dd6381b-83d6-4fe4-8ffe-bad3850e4585","timestamp":"2026-09-08T17:24:23.750Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/OzanDur/Codo/neXus-nexus-worktrees/NXS-LOCAL-0021/scripts/orchestrator_dashboard.py","content":"        \"note\": \"Not this movement's PO turn right now -- saved locally; \"\n                \"post it again once the movement shows in \\\"Awaiting you\\\".\",\n    }\n\n\n# ---------------------------------------------------------------------------\n# Read-only git/gh telemetry (side-effecting; degrade gracefully, never raise)\n# ---------------------------------------------------------------------------\n\ndef git_worktree_porcelain(worktree_path: str | None) -> list[str]:\n    if not worktree_path or not Path(worktree_path).is_dir():\n        return []\n    try:\n        result = subprocess.run(\n            [\"git\", \"status\", \"--porcelain\"], cwd=worktree_path,\n            capture_output=True, text=True, timeout=15,\n        )\n    except (OSError, subprocess.TimeoutExpired):\n        return []\n    if result.returncode != 0:\n        return []\n    return [line for line in result.stdout.splitlines() if line.strip()]\n\n\ndef git_ahead_behind(worktree_path: str | None, base: str = \"origin/main\") -> tuple[int | None, int | None]:\n    if not worktree_path or not Path(worktree_path).is_dir():\n        return None, None\n    try:\n        result = subprocess.run(\n            [\"git\", \"rev-list\", \"--left-right\", \"--count\", f\"{base}...HEAD\"],\n            cwd=worktree_path, capture_output=True, text=True, timeout=15,\n        )\n    except (OSError, subprocess.TimeoutExpired):\n        return None, None\n    if result.returncode != 0:\n        return None, None\n    parts = result.stdout.split()\n    if len(parts) != 2:\n        return None, None\n    try:\n        return int(parts[0]), int(parts[1])\n    except ValueError:\n        return None, None\n\n\ndef gh_pr_info(branch: str | None, worktree_path: str | None) -> dict | None:\n    if not branch or not worktree_path or shutil.which(\"gh\") is None:\n        return None\n    try:\n        result = subprocess.run(\n            [\"gh\", \"pr\", \"list\", \"--head\", branch, \"--json\", \"number,state,statusCheckRollup\", \"--limit\", \"1\"],\n            cwd=worktree_path, capture_output=True, text=True, timeout=15,\n        )\n    except (OSError, subprocess.TimeoutExpired):\n        return None\n    if result.returncode != 0:\n        return None\n    try:\n        data = json.loads(result.stdout)\n    except json.JSONDecodeError:\n        return None\n    if not data:\n        return None\n    pr = data[0]\n    checks = pr.get(\"statusCheckRollup\") or []\n    conclusions = {c.get(\"conclusion\") for c in checks if isinstance(c, dict)}\n    ci = \"unknown\"\n    if conclusions:\n        if \"FAILURE\" in conclusions or \"CANCELLED\" in conclusions:\n            ci = \"red\"\n        elif conclusions == {\"SUCCESS\"}:\n            ci = \"green\"\n        else:\n            ci = \"running\"\n    return {\"number\": pr.get(\"number\"), \"state\": pr.get(\"state\"), \"ci\": ci}\n\n\ndef tail_log_lines(worktree_path: str | None, limit: int) -> list[str]:\n    \"\"\"AC-3's Live-activity/Log surface: `engineer.summary.log`, falling\n    back to raw `engineer.log` if the summary does not exist yet -- never an\n    exception for a movement with no logs at all.\"\"\"\n    if not worktree_path:\n        return []\n    nexus_dir = Path(worktree_path) / \".nexus\"\n    for name in (\"engineer.summary.log\", \"engineer.log\"):\n        path = nexus_dir / name\n        if path.is_file():\n            try:\n                lines = path.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n            except OSError:\n                return []\n            return lines[-limit:]\n    return []\n\n\n# ---------------------------------------------------------------------------\n# Movement summary / detail assembly\n# ---------------------------------------------------------------------------\n\ndef build_pending_action_card(\n    *, movement_id: str, relay_file: Path, relay_obj: dict, worktree_path: str | None, state_dir: Path,\n) -> dict | None:\n    entries = relay_obj.get(\"entries\") or []\n    if not entries or relay_obj.get(\"next_actor\") != \"po\" or relay_obj.get(\"status\") == \"CLOSED\":\n        return None\n    last = entries[-1]\n    if not isinstance(last, dict) or last.get(\"marker\") not in (\"RELAY_QUESTION\", \"RELAY_NOTE\"):\n        return None\n    blocker_source, clean_subject = parse_blocker_tag(last.get(\"subject\") or \"\")\n    text = last.get(\"text\") or \"\"\n    source_relay_seq = len(entries)\n    working_directory = worktree_path or \"\"\n\n    if blocker_source == BLOCKER_PLATFORM_POLICY:\n        return {\n            \"blocker_source\": blocker_source, \"requested_action\": clean_subject, \"detail\": text,\n            \"primary_action_id\": None, \"primary_operation\": None, \"reject_action_id\": None,\n        }\n\n    if blocker_source == BLOCKER_ALREADY_AUTHORIZED:\n        operation = OPERATION_ROUTE_TO_ENGINEER\n        primary_args = {\n            \"marker\": \"RELAY_NOTE\", \"subject\": f\"Routed: {clean_subject}\",\n            \"text\": f\"Automatically routed to engineer -- already authorized. Original request: {text}\",\n            \"next_actor\": \"engineer\",\n        }\n    else:\n        operation = OPERATION_RECORD_DECISION\n        primary_args = {\n            \"marker\": \"RELAY_DECISION\", \"subject\": clean_subject, \"text\": text, \"next_actor\": \"engineer\",\n            \"authorized_by\": \"Product Owner -- dashboard action\", \"scope\": f\"{movement_id} dashboard action\",\n            \"supersedes\": \"none\",\n        }\n\n    primary_id = register_action(\n        state_dir, movement_id, relay_file=str(relay_file), operation=operation, args=primary_args,\n        working_directory=working_directory, source_relay_seq=source_relay_seq,\n    )\n\n    reject_args = {\n        \"marker\": \"RELAY_DECISION\", \"subject\": f\"Declined: {clean_subject}\", \"text\": text, \"next_actor\": \"engineer\",\n        \"authorized_by\": \"Product Owner -- dashboard action\", \"scope\": f\"{movement_id} dashboard action\",\n        \"supersedes\": \"none\",\n    }\n    reject_id = register_action(\n        state_dir, movement_id, relay_file=str(relay_file), operation=OPERATION_REJECT, args=reject_args,\n        working_directory=working_directory, source_relay_seq=source_relay_seq,\n    )\n\n    return {\n        \"blocker_source\": blocker_source, \"requested_action\": clean_subject, \"detail\": text,\n        \"primary_action_id\": primary_id, \"primary_operation\": operation, \"reject_action_id\": reject_id,\n    }\n\n\ndef build_movement_summary(record: dict, relay_dir: Path, state_dir: Path, retry_limit: int) -> dict:\n    row = orch._status_row(record, relay_dir, retry_limit)\n    worktree_path = row.get(\"worktree_path\")\n    porcelain = git_worktree_porcelain(worktree_path)\n    pr_info = gh_pr_info(row.get(\"branch\"), worktree_path)\n\n    relay_status, next_actor, pending_action = row.get(\"relay_status\"), None, None\n    try:\n        relay_file = orch._resolve_relay_file(relay_dir, row[\"movement_id\"])\n        relay_obj = orch._load_relay(relay_file)\n        next_actor = relay_obj.get(\"next_actor\")\n        pending_action = build_pending_action_card(\n            movement_id=row[\"movement_id\"], relay_file=relay_file, relay_obj=relay_obj,\n            worktree_path=worktree_path, state_dir=state_dir,\n        )\n    except orch.OrchestratorError:\n        pass\n\n    stage = derive_work_stage(\n        relay_status=relay_status, next_actor=next_actor, phase=row.get(\"phase\"),\n        porcelain_lines=porcelain, last_activity=row.get(\"last_activity\"), has_open_pr=bool(pr_info),\n    )\n    return {\n        **row,\n        \"process_status\": derive_process_status(row),\n        \"work_stage\": stage,\n        \"next_actor\": next_actor,\n        \"open_pr\": pr_info,\n        \"pending_action\": pending_action,\n        \"outbox_pending\": len(load_outbox(state_dir, row[\"movement_id\"])),\n    }\n\n\ndef gather_movements(state_dir: Path, relay_dir: Path, retry_limit: int) -> dict:\n    summaries = [\n        build_movement_summary(record, relay_dir, state_dir, retry_limit)\n        for record in orch._list_state_records(state_dir)\n    ]\n    summaries.sort(key=lambda s: s[\"movement_id\"])\n    running = [s for s in summaries if s[\"work_stage\"] not in (STAGE_MERGED,) and s[\"process_status\"] != \"disconnected\"]\n    awaiting = [s for s in summaries if s[\"pending_action\"] is not None]\n    recent = [s for s in summaries if s[\"work_stage\"] == STAGE_MERGED]\n    integration = [s for s in summaries if s[\"work_stage\"] == STAGE_INTEGRATION]\n    return {\n        \"summary\": {\n            \"running\": len(running), \"awaiting_decision\": len(awaiting), \"in_integration\": len(integration),\n        },\n        \"movements\": summaries,\n    }\n\n\ndef build_movement_detail(movement_id: str, relay_dir: Path, state_dir: Path, retry_limit: int) -> dict:\n    record = orch._load_state(state_dir, movement_id)\n    if record is None:\n        raise DashboardError(f\"no state record for {movement_id}\")\n    summary = build_movement_summary(record, relay_dir, state_dir, retry_limit)\n\n    relay_file = orch._resolve_relay_file(relay_dir, movement_id)\n    relay_obj = orch._load_relay(relay_file)\n    behind, ahead = git_ahead_behind(record.get(\"worktree_path\"))\n\n    approved_task = None\n    worktree_path = record.get(\"worktree_path\")\n    if worktree_path:\n        task_path = Path(worktree_path) / \".nexus\" / \"approved_task.json\"\n        if task_path.is_file():\n            try:\n                approved_task = json.loads(task_path.read_text(encoding=\"utf-8\"))\n            except (OSError, json.JSONDecodeError):\n                approved_task = None\n\n    return {\n        **summary,\n        \"relay_entries\": relay_obj.get(\"entries\", []),\n        \"relay_id\": relay_obj.get(\"id\"),\n        \"ahead\": ahead, \"behind\": behind,\n        \"approved_task\": approved_task,\n        \"outbox\": load_outbox(state_dir, movement_id),\n    }\n\n\n# ---------------------------------------------------------------------------\n# HTTP layer\n# ---------------------------------------------------------------------------\n\ndef _json_bytes(obj: Any) -> bytes:\n    return (json.dumps(obj, sort_keys=True) + \"\\n\").encode(\"utf-8\")\n\n\ndef make_handler_class(*, token: str, relay_dir: Path, state_dir: Path, repo_root: Path,\n                        retry_limit: int, port: int) -> type[BaseHTTPRequestHandler]:\n    expected_origin = f\"http://127.0.0.1:{port}\"\n\n    class Handler(BaseHTTPRequestHandler):\n        server_version = \"neXusDashboard/1\"\n\n        def log_message(self, fmt: str, *args: Any) -> None:  # quiet by default\n            pass\n\n        # -- auth -------------------------------------------------------\n        def _authorized(self) -> bool:\n            header = self.headers.get(\"Authorization\", \"\")\n            if not header.startswith(\"Bearer \"):\n                return False\n            return hmac.compare_digest(header[len(\"Bearer \"):], token)\n\n        def _origin_ok(self) -> bool:\n            origin = self.headers.get(\"Origin\")\n            return origin is None or origin == expected_origin\n\n        def _send_json(self, status: int, obj: Any) -> None:\n            body = _json_bytes(obj)\n            self.send_response(status)\n            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n\n        def _send_static(self, path: Path, content_type: str) -> None:\n            if not path.is_file():\n                self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n                return\n            body = path.read_bytes()\n            self.send_response(HTTPStatus.OK)\n            self.send_header(\"Content-Type\", content_type)\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n\n        def _read_json_body(self) -> Any:\n            length = int(self.headers.get(\"Content-Length\", 0) or 0)\n            if length <= 0:\n                return {}\n            raw = self.rfile.read(length)\n            try:\n                return json.loads(raw.decode(\"utf-8\"))\n            except (UnicodeDecodeError, json.JSONDecodeError):\n                return None\n\n        # -- routing ------------------------------------------------------\n        def do_GET(self) -> None:  # noqa: N802 -- BaseHTTPRequestHandler naming\n            parts = urlsplit(self.path)\n            path, query = parts.path, parse_qs(parts.query)\n\n            if path == \"/\":\n                self._send_static(ASSETS_DIR / \"index.html\", \"text/html; charset=utf-8\")\n                return\n            if path == \"/dashboard.css\":\n                self._send_static(ASSETS_DIR / \"dashboard.css\", \"text/css; charset=utf-8\")\n                return\n            if path == \"/dashboard.js\":\n                self._send_static(ASSETS_DIR / \"dashboard.js\", \"application/javascript; charset=utf-8\")\n                return\n\n            if not path.startswith(\"/api/\"):\n                self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n                return\n            if not self._authorized():\n                self._send_json(HTTPStatus.UNAUTHORIZED, {\"error\": \"missing or invalid bearer token\"})\n                return\n\n            if path == \"/api/movements\":\n                self._send_json(HTTPStatus.OK, gather_movements(state_dir, relay_dir, retry_limit))\n                return\n            if path == \"/api/config\":\n                self._send_json(HTTPStatus.OK, read_config(repo_root))\n                return\n            if path.startswith(\"/api/movements/\"):\n                rest = path[len(\"/api/movements/\"):]\n                if rest.endswith(\"/log\"):\n                    movement_id = rest[: -len(\"/log\")]\n                    limit = LOG_TAIL_DEFAULT\n                    if \"tail\" in query:\n                        try:\n                            limit = max(1, min(LOG_TAIL_MAX, int(query[\"tail\"][0])))\n                        except ValueError:\n                            pass\n                    record = orch._load_state(state_dir, movement_id)\n                    if record is None:\n                        self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"unknown movement\"})\n                        return\n                    self._send_json(HTTPStatus.OK, {\"lines\": tail_log_lines(record.get(\"worktree_path\"), limit)})\n                    return\n                movement_id = rest\n                try:\n                    detail = build_movement_detail(movement_id, relay_dir, state_dir, retry_limit)\n                except (DashboardError, orch.OrchestratorError) as exc:\n                    self._send_json(HTTPStatus.NOT_FOUND, {\"error\": str(exc)})\n                    return\n                self._send_json(HTTPStatus.OK, detail)\n                return\n\n            self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n\n        def do_PUT(self) -> None:  # noqa: N802\n            if not self.path.startswith(\"/api/\"):\n                self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n                return\n            if not self._authorized():\n                self._send_json(HTTPStatus.UNAUTHORIZED, {\"error\": \"missing or invalid bearer token\"})\n                return\n            if not self._origin_ok():\n                self._send_json(HTTPStatus.FORBIDDEN, {\"error\": \"origin not allowed\"})\n                return\n            if self.path == \"/api/config\":\n                body = self._read_json_body()\n                if not isinstance(body, dict):\n                    self._send_json(HTTPStatus.BAD_REQUEST, {\"error\": \"invalid JSON body\"})\n                    return\n                ok, result = write_config(repo_root, body.get(\"poll_interval_seconds\"))\n                self._send_json(HTTPStatus.OK if ok else HTTPStatus.BAD_REQUEST,\n                                 result if ok else {\"error\": result})\n                return\n            self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n\n        def do_POST(self) -> None:  # noqa: N802\n            if not self.path.startswith(\"/api/movements/\"):\n                self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n                return\n            if not self._authorized():\n                self._send_json(HTTPStatus.UNAUTHORIZED, {\"error\": \"missing or invalid bearer token\"})\n                return\n            if not self._origin_ok():\n                self._send_json(HTTPStatus.FORBIDDEN, {\"error\": \"origin not allowed\"})\n                return\n\n            rest = self.path[len(\"/api/movements/\"):]\n            body = self._read_json_body()\n            if body is None:\n                self._send_json(HTTPStatus.BAD_REQUEST, {\"error\": \"invalid JSON body\"})\n                return\n\n            if \"/actions/\" in rest and rest.endswith(\"/execute\"):\n                movement_id, remainder = rest.split(\"/actions/\", 1)\n                action_id = remainder[: -len(\"/execute\")]\n                try:\n                    relay_file = orch._resolve_relay_file(relay_dir, movement_id)\n                except orch.OrchestratorError as exc:\n                    self._send_json(HTTPStatus.NOT_FOUND, {\"error\": str(exc)})\n                    return\n                try:\n                    result = execute_action(state_dir, movement_id, relay_file, action_id)\n                except DashboardError as exc:\n                    self._send_json(HTTPStatus.CONFLICT, {\"error\": str(exc)})\n                    return\n                self._send_json(HTTPStatus.OK, result)\n                return\n\n            if rest.endswith(\"/message\"):\n                movement_id = rest[: -len(\"/message\")]\n                text = (body or {}).get(\"text\") if isinstance(body, dict) else None\n                if not text or not isinstance(text, str):\n                    self._send_json(HTTPStatus.BAD_REQUEST, {\"error\": \"text is required\"})\n                    return\n                try:\n                    relay_file = orch._resolve_relay_file(relay_dir, movement_id)\n                except orch.OrchestratorError as exc:\n                    self._send_json(HTTPStatus.NOT_FOUND, {\"error\": str(exc)})\n                    return\n                try:\n                    result = send_message(state_dir, movement_id, relay_file, text)\n                except DashboardError as exc:\n                    self._send_json(HTTPStatus.CONFLICT, {\"error\": str(exc)})\n                    return\n                self._send_json(HTTPStatus.OK, result)\n                return\n\n            self._send_json(HTTPStatus.NOT_FOUND, {\"error\": \"not found\"})\n\n    return Handler\n\n\n# ---------------------------------------------------------------------------\n# CLI\n# ---------------------------------------------------------------------------\n\ndef run_dashboard(*, port: int, relay_dir: Path, state_dir: Path, repo_root: Path, retry_limit: int) -> None:\n    token = secrets.token_urlsafe(32)\n    handler_cls = make_handler_class(\n        token=token, relay_dir=relay_dir, state_dir=state_dir, repo_root=repo_root,\n        retry_limit=retry_limit, port=port,\n    )\n    httpd = ThreadingHTTPServer((\"127.0.0.1\", port), handler_cls)\n    print(f\"neXus dashboard listening -- open http://127.0.0.1:{port}/#t={token}\")\n    try:\n        httpd.serve_forever()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        httpd.server_close()\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(prog=\"orchestrator_dashboard\", description=__doc__)\n    parser.add_argument(\"--port\", type=int, default=DEFAULT_PORT)\n    parser.add_argument(\"--relay-dir\", default=\"relay\")\n    parser.add_argument(\"--state-dir\", default=str(orch.DEFAULT_STATE_DIR))\n    parser.add_argument(\"--repo-root\", default=str(REPO_ROOT))\n    parser.add_argument(\"--retry-limit\", type=int, default=orch.DEFAULT_RETRY_LIMIT)\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    run_dashboard(\n        port=args.port, relay_dir=Path(args.relay_dir).resolve(), state_dir=Path(args.state_dir),\n        repo_root=Path(args.repo_root).resolve(), retry_limit=args.retry_limit,\n    )\n    return 0\n\n\nif __name__ == \"__main__\":","numLines":467,"startLine":400,"totalLines":868}}}
