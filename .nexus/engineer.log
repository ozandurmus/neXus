{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BfUX9vxi1LeDjs7Bbru5HM","type":"tool_result","content":"1\t\"\"\"project/backlog.json id orchestrator_interactive_dashboard_app -- AC-7\n2\ttargeted tests for the data/API layer only (no browser test harness, same\n3\ttesting philosophy relay/NXS-LOCAL-0013's own watch-loop tests used):\n4\tstage-derivation, the action-id registry/staleness check, and the config\n5\tread/write \"endpoint\" (its underlying functions, exercised directly).\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport json\n10\timport sys\n11\tfrom pathlib import Path\n12\t\n13\timport pytest\n14\t\n15\tROOT = Path(__file__).resolve().parent.parent\n16\tsys.path.insert(0, str(ROOT / \"scripts\"))\n17\timport orchestrator as orch  # noqa: E402\n18\timport orchestrator_dashboard as dash  # noqa: E402\n19\timport local_relay as lr  # noqa: E402\n20\t\n21\t\n22\t# ---------------------------------------------------------------------------\n23\t# derive_process_status\n24\t# ---------------------------------------------------------------------------\n25\t\n26\tdef test_process_status_running_when_pid_alive():\n27\t    assert dash.derive_process_status({\"pid_alive\": True, \"pid\": 123}) == \"running\"\n28\t\n29\t\n30\tdef test_process_status_exited_when_pid_present_but_dead():\n31\t    assert dash.derive_process_status({\"pid_alive\": False, \"pid\": 123}) == \"exited\"\n32\t\n33\t\n34\tdef test_process_status_disconnected_when_no_pid():\n35\t    assert dash.derive_process_status({\"pid_alive\": False, \"pid\": None}) == \"disconnected\"\n36\t\n37\t\n38\t# ---------------------------------------------------------------------------\n39\t# derive_work_stage -- never inferred from git dirtiness alone\n40\t# ---------------------------------------------------------------------------\n41\t\n42\tdef _stage(**kwargs):\n43\t    defaults = dict(\n44\t        relay_status=\"AWAITING_ENGINEER\", next_actor=\"engineer\", phase=orch.PHASE_RUNNING,\n45\t        porcelain_lines=[], last_activity=None, has_open_pr=False,\n46\t    )\n47\t    defaults.update(kwargs)\n48\t    return dash.derive_work_stage(**defaults)\n49\t\n50\t\n51\tdef test_stage_merged_when_relay_closed():\n52\t    assert _stage(relay_status=\"CLOSED\") == dash.STAGE_MERGED\n53\t\n54\t\n55\tdef test_stage_merged_when_phase_done_even_if_relay_status_missing():\n56\t    assert _stage(relay_status=None, phase=orch.PHASE_DONE) == dash.STAGE_MERGED\n57\t\n58\t\n59\tdef test_stage_awaiting_po_takes_priority_over_dirty_worktree():\n60\t    assert _stage(next_actor=\"po\", porcelain_lines=[\"M foo.py\"]) == dash.STAGE_AWAITING_PO\n61\t\n62\t\n63\tdef test_stage_resolving_merge_conflict_from_unmerged_porcelain_codes():\n64\t    assert _stage(porcelain_lines=[\"UU foo.py\"]) == dash.STAGE_RESOLVING_CONFLICT\n65\t\n66\t\n67\tdef test_stage_integration_when_open_pr_present():\n68\t    assert _stage(has_open_pr=True) == dash.STAGE_INTEGRATION\n69\t\n70\t\n71\tdef test_stage_testing_from_real_last_activity_signal():\n72\t    assert _stage(last_activity=\"tool_use: Bash py -m pytest -q -n auto\") == dash.STAGE_TESTING\n73\t\n74\t\n75\tdef test_stage_coding_when_dirty_and_no_stronger_signal():\n76\t    assert _stage(porcelain_lines=[\"M foo.py\"]) == dash.STAGE_CODING\n77\t\n78\t\n79\tdef test_stage_not_started_when_clean_and_relay_open():\n80\t    assert _stage(relay_status=\"OPEN\", porcelain_lines=[]) == dash.STAGE_NOT_STARTED"}]},"parent_tool_use_id":null,"session_id":"2940a6ba-1db4-4dd1-973a-c2b7cdc738e2","uuid":"86daaeb9-a261-4a5a-9691-27471a4483d2","timestamp":"2026-09-08T17:24:30.146Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/OzanDur/Codo/neXus-nexus-worktrees/NXS-LOCAL-0021/tests/test_orchestrator_dashboard.py","content":"\"\"\"project/backlog.json id orchestrator_interactive_dashboard_app -- AC-7\ntargeted tests for the data/API layer only (no browser test harness, same\ntesting philosophy relay/NXS-LOCAL-0013's own watch-loop tests used):\nstage-derivation, the action-id registry/staleness check, and the config\nread/write \"endpoint\" (its underlying functions, exercised directly).\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nROOT = Path(__file__).resolve().parent.parent\nsys.path.insert(0, str(ROOT / \"scripts\"))\nimport orchestrator as orch  # noqa: E402\nimport orchestrator_dashboard as dash  # noqa: E402\nimport local_relay as lr  # noqa: E402\n\n\n# ---------------------------------------------------------------------------\n# derive_process_status\n# ---------------------------------------------------------------------------\n\ndef test_process_status_running_when_pid_alive():\n    assert dash.derive_process_status({\"pid_alive\": True, \"pid\": 123}) == \"running\"\n\n\ndef test_process_status_exited_when_pid_present_but_dead():\n    assert dash.derive_process_status({\"pid_alive\": False, \"pid\": 123}) == \"exited\"\n\n\ndef test_process_status_disconnected_when_no_pid():\n    assert dash.derive_process_status({\"pid_alive\": False, \"pid\": None}) == \"disconnected\"\n\n\n# ---------------------------------------------------------------------------\n# derive_work_stage -- never inferred from git dirtiness alone\n# ---------------------------------------------------------------------------\n\ndef _stage(**kwargs):\n    defaults = dict(\n        relay_status=\"AWAITING_ENGINEER\", next_actor=\"engineer\", phase=orch.PHASE_RUNNING,\n        porcelain_lines=[], last_activity=None, has_open_pr=False,\n    )\n    defaults.update(kwargs)\n    return dash.derive_work_stage(**defaults)\n\n\ndef test_stage_merged_when_relay_closed():\n    assert _stage(relay_status=\"CLOSED\") == dash.STAGE_MERGED\n\n\ndef test_stage_merged_when_phase_done_even_if_relay_status_missing():\n    assert _stage(relay_status=None, phase=orch.PHASE_DONE) == dash.STAGE_MERGED\n\n\ndef test_stage_awaiting_po_takes_priority_over_dirty_worktree():\n    assert _stage(next_actor=\"po\", porcelain_lines=[\"M foo.py\"]) == dash.STAGE_AWAITING_PO\n\n\ndef test_stage_resolving_merge_conflict_from_unmerged_porcelain_codes():\n    assert _stage(porcelain_lines=[\"UU foo.py\"]) == dash.STAGE_RESOLVING_CONFLICT\n\n\ndef test_stage_integration_when_open_pr_present():\n    assert _stage(has_open_pr=True) == dash.STAGE_INTEGRATION\n\n\ndef test_stage_testing_from_real_last_activity_signal():\n    assert _stage(last_activity=\"tool_use: Bash py -m pytest -q -n auto\") == dash.STAGE_TESTING\n\n\ndef test_stage_coding_when_dirty_and_no_stronger_signal():\n    assert _stage(porcelain_lines=[\"M foo.py\"]) == dash.STAGE_CODING\n\n\ndef test_stage_not_started_when_clean_and_relay_open():\n    assert _stage(relay_status=\"OPEN\", porcelain_lines=[]) == dash.STAGE_NOT_STARTED","numLines":80,"startLine":1,"totalLines":376}}}
