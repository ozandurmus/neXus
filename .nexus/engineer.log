{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019xSVFshX5tbxWyJGcGKcm6","type":"tool_result","content":"698\tdef _status_row(record: dict, relay_dir: Path, retry_limit: int) -> dict:\n699\t    is_alive = pid_alive(record.get(\"pid\"))\n700\t    relay_status = None\n701\t    last_marker, last_timestamp = None, None\n702\t    try:\n703\t        relay_file = _resolve_relay_file(relay_dir, record[\"movement_id\"])\n704\t        relay_obj = _load_relay(relay_file)\n705\t        relay_status = relay_obj.get(\"status\")\n706\t        entries = relay_obj.get(\"entries\") or []\n707\t        dispatch_seq = record.get(\"dispatch_seq\")\n708\t        if dispatch_seq is not None and len(entries) > dispatch_seq:\n709\t            last_marker = \"REVISION_CHANGED_SINCE_DISPATCH\"\n710\t        if entries:\n711\t            last_marker = last_marker or entries[-1].get(\"marker\")\n712\t            last_timestamp = entries[-1].get(\"timestamp\")\n713\t    except OrchestratorError:\n714\t        pass\n715\t    phase = reconcile_phase(record, is_alive, relay_status, retry_limit)\n716\t    if phase != record.get(\"phase\"):\n717\t        record = {**record, \"phase\": phase}\n718\t    return {\n719\t        \"movement_id\": record[\"movement_id\"], \"phase\": phase, \"pid\": record.get(\"pid\"),\n720\t        \"pid_alive\": is_alive, \"revision\": record.get(\"revision\"), \"branch\": record.get(\"branch\"),\n721\t        \"worktree_path\": record.get(\"worktree_path\"), \"started_at\": record.get(\"started_at\"),\n722\t        \"retry_count\": record.get(\"retry_count\", 0), \"relay_status\": relay_status,\n723\t        \"last_marker\": last_marker, \"last_timestamp\": last_timestamp,\n724\t        # AC-4: the most recent engineer.summary.log line, or None -- never\n725\t        # an exception -- for a movement dispatched before AC-1/AC-2 landed\n726\t        # (AC-5's own backward-compatibility requirement).\n727\t        \"last_activity\": _read_last_activity(record.get(\"worktree_path\")),\n728\t        \"heartbeat_age_seconds\": _heartbeat_age_seconds(record),\n729\t    }\n730\t\n731\t\n732\tdef _cmd_status(args: argparse.Namespace) -> int:\n733\t    relay_dir = Path(args.relay_dir).resolve()\n734\t    state_dir = Path(args.state_dir)\n735\t    if args.movement:\n736\t        record = _load_state(state_dir, args.movement)\n737\t        if record is None:\n738\t            print(f\"error: no state record for {args.movement}\", file=sys.stderr)\n739\t            return EXIT_USAGE\n740\t        row = _status_row(record, relay_dir, args.retry_limit)\n741\t        _save_state(state_dir, args.movement, {**record, \"phase\": row[\"phase\"]})\n742\t        print(json.dumps(row, sort_keys=True))\n743\t        return EXIT_OK\n744\t\n745\t    rows = []\n746\t    for record in _list_state_records(state_dir):\n747\t        row = _status_row(record, relay_dir, args.retry_limit)\n748\t        _save_state(state_dir, record[\"movement_id\"], {**record, \"phase\": row[\"phase\"]})\n749\t        rows.append(row)\n750\t    print(json.dumps(sorted(rows, key=lambda r: r[\"movement_id\"]), sort_keys=True))\n751\t    return EXIT_OK\n752\t\n753\t\n754\t# ---------------------------------------------------------------------------\n755\t# stop\n756\t# ---------------------------------------------------------------------------\n757\t"}]},"parent_tool_use_id":null,"session_id":"2940a6ba-1db4-4dd1-973a-c2b7cdc738e2","uuid":"6f778c3d-33ff-4051-9dc4-347ec1af6480","timestamp":"2026-09-08T17:30:52.279Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/OzanDur/Codo/neXus-nexus-worktrees/NXS-LOCAL-0021/scripts/orchestrator.py","content":"def _status_row(record: dict, relay_dir: Path, retry_limit: int) -> dict:\n    is_alive = pid_alive(record.get(\"pid\"))\n    relay_status = None\n    last_marker, last_timestamp = None, None\n    try:\n        relay_file = _resolve_relay_file(relay_dir, record[\"movement_id\"])\n        relay_obj = _load_relay(relay_file)\n        relay_status = relay_obj.get(\"status\")\n        entries = relay_obj.get(\"entries\") or []\n        dispatch_seq = record.get(\"dispatch_seq\")\n        if dispatch_seq is not None and len(entries) > dispatch_seq:\n            last_marker = \"REVISION_CHANGED_SINCE_DISPATCH\"\n        if entries:\n            last_marker = last_marker or entries[-1].get(\"marker\")\n            last_timestamp = entries[-1].get(\"timestamp\")\n    except OrchestratorError:\n        pass\n    phase = reconcile_phase(record, is_alive, relay_status, retry_limit)\n    if phase != record.get(\"phase\"):\n        record = {**record, \"phase\": phase}\n    return {\n        \"movement_id\": record[\"movement_id\"], \"phase\": phase, \"pid\": record.get(\"pid\"),\n        \"pid_alive\": is_alive, \"revision\": record.get(\"revision\"), \"branch\": record.get(\"branch\"),\n        \"worktree_path\": record.get(\"worktree_path\"), \"started_at\": record.get(\"started_at\"),\n        \"retry_count\": record.get(\"retry_count\", 0), \"relay_status\": relay_status,\n        \"last_marker\": last_marker, \"last_timestamp\": last_timestamp,\n        # AC-4: the most recent engineer.summary.log line, or None -- never\n        # an exception -- for a movement dispatched before AC-1/AC-2 landed\n        # (AC-5's own backward-compatibility requirement).\n        \"last_activity\": _read_last_activity(record.get(\"worktree_path\")),\n        \"heartbeat_age_seconds\": _heartbeat_age_seconds(record),\n    }\n\n\ndef _cmd_status(args: argparse.Namespace) -> int:\n    relay_dir = Path(args.relay_dir).resolve()\n    state_dir = Path(args.state_dir)\n    if args.movement:\n        record = _load_state(state_dir, args.movement)\n        if record is None:\n            print(f\"error: no state record for {args.movement}\", file=sys.stderr)\n            return EXIT_USAGE\n        row = _status_row(record, relay_dir, args.retry_limit)\n        _save_state(state_dir, args.movement, {**record, \"phase\": row[\"phase\"]})\n        print(json.dumps(row, sort_keys=True))\n        return EXIT_OK\n\n    rows = []\n    for record in _list_state_records(state_dir):\n        row = _status_row(record, relay_dir, args.retry_limit)\n        _save_state(state_dir, record[\"movement_id\"], {**record, \"phase\": row[\"phase\"]})\n        rows.append(row)\n    print(json.dumps(sorted(rows, key=lambda r: r[\"movement_id\"]), sort_keys=True))\n    return EXIT_OK\n\n\n# ---------------------------------------------------------------------------\n# stop\n# ---------------------------------------------------------------------------\n","numLines":60,"startLine":698,"totalLines":980}}}
