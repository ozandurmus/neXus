{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015WVgwgwMSnjeox4u9vxVNq","type":"tool_result","content":"1\t\"\"\"GOV.PO.3 -- scripts/orchestrator.py (docs/design/\n2\tGOV_PO_3_APPROVED_MOVEMENT_ORCHESTRATION.md, FROZEN).\n3\t\n4\tCovers the pure decision logic (dispatch/resume/refuse, merge-lock\n5\tacquire, phase reconciliation, task hashing, git-ref validation) without\n6\tspawning a real `claude -p` process or a real git worktree -- those are\n7\texercised by the AC-5 demonstrations, not by this suite. A handful of\n8\tCLI-level tests wire the pure functions together with monkeypatched\n9\tgit/spawn side effects to prove `start`/`status`/`merge-lock` plumbing.\n10\t\"\"\"\n11\tfrom __future__ import annotations\n12\t\n13\timport json\n14\timport os\n15\timport subprocess\n16\timport sys\n17\timport time\n18\tfrom pathlib import Path\n19\t\n20\timport pytest\n21\t\n22\tROOT = Path(__file__).resolve().parent.parent\n23\tsys.path.insert(0, str(ROOT / \"scripts\"))\n24\timport orchestrator as orch  # noqa: E402\n25\timport local_relay as lr  # noqa: E402\n26\t\n27\t\n28\tdef _start_report(**overrides) -> dict:\n29\t    report = {\n30\t        \"baseline\": {\"origin_main\": \"deadbeef\"},\n31\t        \"objective\": \"Exercise the orchestrator.\",\n32\t        \"scope\": {\"in\": [\"do the thing\"], \"out\": [\"not that thing\"]},\n33\t        \"movement_type\": \"VALIDATION\",\n34\t        \"requirements\": [\"exactly one schema\"],\n35\t        \"acceptance_criteria\": [\"round-trips cleanly\"],\n36\t        \"validation_plan\": [\"run the focused suite\"],\n37\t        \"invariants\": [\"repository stays authoritative\"],\n38\t        \"risks\": [],\n39\t        \"context_not_loaded\": [],\n40\t        \"recommended_reasoning\": {\"tier\": \"Normal\", \"reason\": \"deterministic implementation\"},\n41\t        \"git\": {\"lane\": \"feature/x\", \"base\": \"origin/main\"},\n42\t        \"merge_gate\": \"n/a\",\n43\t        \"deployment_direction\": \"local validation only\",\n44\t        \"output_contract\": [\"exactly one relay file\"],\n45\t    }\n46\t    report.update(overrides)\n47\t    return report\n48\t\n49\t\n50\tdef _make_relay(tmp_path: Path, movement: str = \"TEST_MOVEMENT\", **report_overrides) -> Path:\n51\t    \"\"\"A real, schema-valid relay dir with one movement, next_actor=engineer\n52\t    (create()'s own default when the creating role is \"po\") -- built through\n53\t    local_relay.py itself so it is guaranteed valid, never hand-rolled JSON.\"\"\"\n54\t    relay_dir = tmp_path / \"relay\"\n55\t    start = tmp_path / \"start.json\"\n56\t    start.write_text(json.dumps({\n57\t        \"protocol_version\": 2, \"message_type\": \"SESSION_START\", \"movement\": movement,\n58\t        \"refs\": [], \"report\": _start_report(**report_overrides),\n59\t    }), encoding=\"utf-8\")\n60\t    rc = lr.main([\"create\", \"--role\", \"po\", \"--start\", str(start), \"--dir\", str(relay_dir)])\n61\t    assert rc == lr.EXIT_OK\n62\t    return relay_dir\n63\t\n64\t\n65\tclass _FakeProc:\n66\t    def __init__(self, pid: int) -> None:\n67\t        self.pid = pid\n68\t\n69\t\n70\tdef _dead_pid() -> int:\n71\t    proc = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n72\t    proc.wait()\n73\t    return proc.pid\n74\t\n75\t\n76\t# --- canonical hashing (section 3.5) ---------------------------------------\n77\t\n78\tdef test_task_hash_is_reproducible_for_identical_content():\n79\t    entry = {\"seq\": 1, \"marker\": \"SESSION_START\", \"actor\": \"po\", \"timestamp\": \"t\", \"report\": {\"a\": 1}}\n80\t    assert orch.task_hash(entry) == orch.task_hash(dict(entry))\n81\t\n82\t\n83\tdef test_task_hash_changes_when_content_changes():\n84\t    entry = {\"seq\": 1, \"marker\": \"SESSION_START\", \"actor\": \"po\", \"timestamp\": \"t\", \"report\": {\"a\": 1}}\n85\t    other = {**entry, \"report\": {\"a\": 2}}\n86\t    assert orch.task_hash(entry) != orch.task_hash(other)\n87\t\n88\t\n89\tdef test_task_hash_is_insensitive_to_key_order():\n90\t    a = {\"seq\": 1, \"marker\": \"SESSION_START\", \"actor\": \"po\", \"timestamp\": \"t\", \"report\": {\"a\": 1, \"b\": 2}}\n91\t    b = {\"marker\": \"SESSION_START\", \"report\": {\"b\": 2, \"a\": 1}, \"seq\": 1, \"actor\": \"po\", \"timestamp\": \"t\"}\n92\t    assert orch.task_hash(a) == orch.task_hash(b)\n93\t\n94\t\n95\tdef test_canonical_json_matches_what_gets_written_to_disk(tmp_path):\n96\t    entry = {\"seq\": 1, \"marker\": \"SESSION_START\", \"actor\": \"po\", \"timestamp\": \"t\", \"report\": {\"a\": 1}}\n97\t    path = tmp_path / \"approved_task.json\"\n98\t    path.write_text(orch.canonical_json(entry), encoding=\"utf-8\")\n99\t    rehashed = __import__(\"hashlib\").sha256(path.read_bytes()).hexdigest()\n100\t    assert rehashed == orch.task_hash(entry)"}]},"parent_tool_use_id":null,"session_id":"4a8dd4a7-31e7-434f-89b1-73b3ad9d3b22","uuid":"f31508c2-91fe-4bc6-b213-db6dcd66f863","timestamp":"2026-09-08T17:08:04.828Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/OzanDur/Codo/neXus-nexus-worktrees/NXS-LOCAL-0021/tests/test_orchestrator.py","content":"\"\"\"GOV.PO.3 -- scripts/orchestrator.py (docs/design/\nGOV_PO_3_APPROVED_MOVEMENT_ORCHESTRATION.md, FROZEN).\n\nCovers the pure decision logic (dispatch/resume/refuse, merge-lock\nacquire, phase reconciliation, task hashing, git-ref validation) without\nspawning a real `claude -p` process or a real git worktree -- those are\nexercised by the AC-5 demonstrations, not by this suite. A handful of\nCLI-level tests wire the pure functions together with monkeypatched\ngit/spawn side effects to prove `start`/`status`/`merge-lock` plumbing.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nimport pytest\n\nROOT = Path(__file__).resolve().parent.parent\nsys.path.insert(0, str(ROOT / \"scripts\"))\nimport orchestrator as orch  # noqa: E402\nimport local_relay as lr  # noqa: E402\n\n\ndef _start_report(**overrides) -> dict:\n    report = {\n        \"baseline\": {\"origin_main\": \"deadbeef\"},\n        \"objective\": \"Exercise the orchestrator.\",\n        \"scope\": {\"in\": [\"do the thing\"], \"out\": [\"not that thing\"]},\n        \"movement_type\": \"VALIDATION\",\n        \"requirements\": [\"exactly one schema\"],\n        \"acceptance_criteria\": [\"round-trips cleanly\"],\n        \"validation_plan\": [\"run the focused suite\"],\n        \"invariants\": [\"repository stays authoritative\"],\n        \"risks\": [],\n        \"context_not_loaded\": [],\n        \"recommended_reasoning\": {\"tier\": \"Normal\", \"reason\": \"deterministic implementation\"},\n        \"git\": {\"lane\": \"feature/x\", \"base\": \"origin/main\"},\n        \"merge_gate\": \"n/a\",\n        \"deployment_direction\": \"local validation only\",\n        \"output_contract\": [\"exactly one relay file\"],\n    }\n    report.update(overrides)\n    return report\n\n\ndef _make_relay(tmp_path: Path, movement: str = \"TEST_MOVEMENT\", **report_overrides) -> Path:\n    \"\"\"A real, schema-valid relay dir with one movement, next_actor=engineer\n    (create()'s own default when the creating role is \"po\") -- built through\n    local_relay.py itself so it is guaranteed valid, never hand-rolled JSON.\"\"\"\n    relay_dir = tmp_path / \"relay\"\n    start = tmp_path / \"start.json\"\n    start.write_text(json.dumps({\n        \"protocol_version\": 2, \"message_type\": \"SESSION_START\", \"movement\": movement,\n        \"refs\": [], \"report\": _start_report(**report_overrides),\n    }), encoding=\"utf-8\")\n    rc = lr.main([\"create\", \"--role\", \"po\", \"--start\", str(start), \"--dir\", str(relay_dir)])\n    assert rc == lr.EXIT_OK\n    return relay_dir\n\n\nclass _FakeProc:\n    def __init__(self, pid: int) -> None:\n        self.pid = pid\n\n\ndef _dead_pid() -> int:\n    proc = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n    proc.wait()\n    return proc.pid\n\n\n# --- canonical hashing (section 3.5) ---------------------------------------\n\ndef test_task_hash_is_reproducible_for_identical_content():\n    entry = {\"seq\": 1, \"marker\": \"SESSION_START\", \"actor\": \"po\", \"timestamp\": \"t\", \"report\": {\"a\": 1}}\n    assert orch.task_hash(entry) == orch.task_hash(dict(entry))\n\n\ndef test_task_hash_changes_when_content_changes():\n    entry = {\"seq\": 1, \"marker\": \"SESSION_START\", \"actor\": \"po\", \"timestamp\": \"t\", \"report\": {\"a\": 1}}\n    other = {**entry, \"report\": {\"a\": 2}}\n    assert orch.task_hash(entry) != orch.task_hash(other)\n\n\ndef test_task_hash_is_insensitive_to_key_order():\n    a = {\"seq\": 1, \"marker\": \"SESSION_START\", \"actor\": \"po\", \"timestamp\": \"t\", \"report\": {\"a\": 1, \"b\": 2}}\n    b = {\"marker\": \"SESSION_START\", \"report\": {\"b\": 2, \"a\": 1}, \"seq\": 1, \"actor\": \"po\", \"timestamp\": \"t\"}\n    assert orch.task_hash(a) == orch.task_hash(b)\n\n\ndef test_canonical_json_matches_what_gets_written_to_disk(tmp_path):\n    entry = {\"seq\": 1, \"marker\": \"SESSION_START\", \"actor\": \"po\", \"timestamp\": \"t\", \"report\": {\"a\": 1}}\n    path = tmp_path / \"approved_task.json\"\n    path.write_text(orch.canonical_json(entry), encoding=\"utf-8\")\n    rehashed = __import__(\"hashlib\").sha256(path.read_bytes()).hexdigest()\n    assert rehashed == orch.task_hash(entry)","numLines":100,"startLine":1,"totalLines":764}}}
