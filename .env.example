# SecurityExpert — non-interactive runtime configuration (DEV.2.1)
#
# Reference only. Nothing in the codebase auto-loads this file; the container
# runtime injects the environment (Compose `env_file:` / `environment:`,
# Kubernetes `envFrom`). Copy to `.env` for local shell use if you want, but
# `.env` is gitignored and never read automatically.
#
# Per value, precedence is:  <VAR>_FILE  >  <VAR>  >  interactive prompt (TTY only)
# When stdin is not a TTY and a required value is unresolved, the process exits
# immediately naming the missing variable(s) — it never hangs on a prompt.
#
# The `<VAR>_FILE` variant points at a file whose (stripped) contents are the
# value — the Docker / Kubernetes secret-mount convention. Prefer it for the
# secret.

# Login / principal for CP SSH and PAN API auth
SECURITYEXPERT_PRINCIPAL=
# SECURITYEXPERT_PRINCIPAL_FILE=/run/secrets/securityexpert_principal

# Authentication secret (password / API secret)
SECURITYEXPERT_SECRET=
# SECURITYEXPERT_SECRET_FILE=/run/secrets/securityexpert_secret

# Check Point Management (MDS/SMC) endpoint — hostname or IP.
# Required for --only cp / vsx / all and the --cp-config-* modes.
SECURITYEXPERT_CP_MDS_ENDPOINT=
# SECURITYEXPERT_CP_MDS_ENDPOINT_FILE=/run/secrets/securityexpert_cp_mds_endpoint

# Palo Alto Panorama endpoint — hostname or IP.
# Required for --only panorama / pan-config / all.
SECURITYEXPERT_PANORAMA_ENDPOINT=
# SECURITYEXPERT_PANORAMA_ENDPOINT_FILE=/run/secrets/securityexpert_panorama_endpoint

# External runtime root (state/output/logs live here, never in the repo).
# On Windows it defaults to %LOCALAPPDATA%\SecurityExpert\runtime; on macOS/
# Linux it defaults to $XDG_DATA_HOME/SecurityExpert/runtime (else
# $HOME/.local/share/SecurityExpert/runtime) -- a local dev convenience only.
# A container MUST set this explicitly to its mounted runtime volume (see
# docker-compose.yml) rather than rely on that default.
SECURITYEXPERT_RUNTIME_ROOT=/runtime

# --- Optional: existing per-path / hardening variables (unchanged by DEV.2.1) ---
# SECURITYEXPERT_CP_CONFIG_SSH_USERNAME=
# SECURITYEXPERT_CP_CONFIG_SSH_PASSWORD=

# --- Production trust hardening (DEV.2.2) ---
# Opt-in here; on the DEPLOY.1 server these move to mounted-and-required via
# docker-compose.prod.yml (deploy/secrets/README.md), not just an env flag --
# the strict host-key check fails closed with no usable host keys, and the
# CA bundle preflight fails closed if the path is not readable.
# SECURITYEXPERT_CP_MDS_STRICT_HOST_KEY=1
# SECURITYEXPERT_PAN_CA_BUNDLE=/etc/ssl/certs/corporate-ca.pem

# Verify the above (and that data/.support_hmac.key already exists on the
# persistent volume from a prior run) with:
#   python main.py --persistent-secret-material-check
