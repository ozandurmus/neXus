{
 "archive": {
  "bytes": 397226091,
  "file": "packet-analysis-parity-corpus.tar.gz",
  "layout": "run1/<case>/{input,l2,canonical}/...",
  "sha256": "00f5957f02fd7ec9e7ac6a76f096d16f7ad32b1a8e9aff60059799a9033db42a"
 },
 "canonicalization": {
  "commit_masking": "private/link-local IPv4 literals in key sections -> <ipv4:SHA256_12>",
  "l1_sql": "WITH r AS (\n  SELECT p.* REPLACE (c.name AS capture_id) FROM packets p JOIN captures c ON c.id = p.capture_id\n)\nSELECT capture_id AS capture, count(*) AS row_count,\n  sha256(string_agg(to_json(r)::VARCHAR, chr(10) ORDER BY frame)) AS sha256\nFROM r GROUP BY capture_id ORDER BY capture_id",
  "l2_tables": [
   "obs",
   "observation_matches",
   "events",
   "flow_summary",
   "clock_values"
  ],
  "l3": "tools/packet_analysis/parity/canonical.py (port of PacketBreaker tests/test_golden.py)"
 },
